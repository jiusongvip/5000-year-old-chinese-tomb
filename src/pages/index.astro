---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sites } from '../data/sites';
import SiteCard from '../components/SiteCard.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTACard from '../components/CTACard.astro';
import { Landmark, Route, MapPin, Map, Ticket, BadgeCheck, ShieldCheck, Footprints, Ban, ArrowRight, ChevronDown } from '@lucide/astro';

const title = 'Walk Through 5,000 Years';
const description = 'Step-by-step guides to visit ancient Chinese archaeological sites — ticket prices, museum booking instructions, and itineraries for foreign travelers.';

const faqHomeSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", "name": "Can I visit ancient Chinese archaeological sites as a foreigner?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Most major archaeological sites in China are open to foreign visitors. Some require advance booking through WeChat mini-programs (especially Sanxingdui and the Shaanxi History Museum). Many nationalities also qualify for China's 240-hour transit visa-free policy, making it easier than ever to visit." } },
    { "@type": "Question", "name": "What is the oldest archaeological site I can visit in China?", "acceptedAnswer": { "@type": "Answer", "text": "The Dawenkou Site in Shandong Province (6,300 years old) is the oldest site on our list that is open to visitors. The Liangzhu Ancient City near Hangzhou (5,300 years old) is a UNESCO World Heritage Site and features an excellent modern museum. Both predate the Egyptian pyramids." } },
    { "@type": "Question", "name": "How do I book Chinese museum tickets with a foreign passport?", "acceptedAnswer": { "@type": "Answer", "text": "Most Chinese museums require booking through WeChat mini-programs. When booking, select 'Passport' (护照) as your ID type and enter your passport number. Some museums sell out weeks in advance (especially Sanxingdui and the Shaanxi History Museum). Our museum booking guides provide step-by-step instructions for each major museum." } },
    { "@type": "Question", "name": "Which ancient Chinese sites are UNESCO World Heritage?", "acceptedAnswer": { "@type": "Answer", "text": "On our site: Liangzhu Ancient City (inscribed 2019), Yin Xu (2006), and the Terracotta Warriors (1987). Sanxingdui is on the UNESCO tentative list. Other UNESCO ancient sites in China include the Longmen Grottoes, Mogao Caves, and the Peking Man site at Zhoukoudian." } },
    { "@type": "Question", "name": "What is the best ancient China itinerary for a first-time visitor?", "acceptedAnswer": { "@type": "Answer", "text": "Our 10-day itinerary covers four major sites (Liangzhu, Sanxingdui, Terracotta Warriors, and Yin Xu) and works as a visa-free transit trip. For a shorter trip, the 7-day Xi'an & Chengdu route focuses on the Terracotta Warriors and Sanxingdui with comfortable train connections." } },
  ],
};

const schemaJson = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": sites.map((s, i) => ({
      "@type": "TouristAttraction",
      "name": s.name,
      "url": `https://5000-year-old-chinese-tomb.com/#sites`,
      "position": i + 1,
    })),
  },
  faqHomeSchema,
]);

const eraColors: Record<string, { dot: string; track: string; label: string }> = {
  'Neolithic': { dot: 'bg-jade-500', track: 'bg-jade-400/40', label: 'Neolithic' },
  'Bronze Age': { dot: 'bg-bronze-500', track: 'bg-bronze-400/40', label: 'Bronze Age' },
  'Imperial': { dot: 'bg-clay-500', track: 'bg-clay-400/40', label: 'Imperial' },
};

const eraTimeline = ['Neolithic', 'Bronze Age', 'Imperial'].map((era) => {
  const group = sites.filter((s) => s.era === era);
  const from = Math.max(...group.map((s) => s.yearsAgo));
  const to = Math.min(...group.map((s) => s.yearsAgo));
  const span = from - to || 1;
  return {
    label: eraColors[era].label,
    dot: eraColors[era].dot,
    track: eraColors[era].track,
    range: `${from.toLocaleString()}–${to.toLocaleString()} years ago`,
    sites: group.map((site, idx) => ({
      site,
      pct: ((from - site.yearsAgo) / span) * 100,
      above: idx % 2 === 1,
    })),
  };
});

const relatedLinks = [
  { href: '#plan', label: 'best time to visit china for ancient sites' },
  { href: '#sites', label: 'terracotta warriors tickets' },
  { href: '#sites', label: 'how to book sanxingdui tickets with foreign passport' },
  { href: '#plan', label: 'china 240 hour transit visa free' },
  { href: '#sites', label: 'oldest archaeological site in china' },
  { href: '#routes', label: 'ancient china itinerary 10 days' },
];
---

<BaseLayout {title} {description} schemaJson={schemaJson}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
  </Fragment>

  <!-- Hero -->
  <section class="relative min-h-[100dvh] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/og-home.webp" alt="Ancient Chinese archaeological sites" width="1200" height="630" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-b from-warm-900/60 via-warm-900/40 to-surface"></div>
    </div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 pt-16 pb-24">
      <p class="text-sm font-medium tracking-wide text-warm-200/80 mb-6">Ancient China Travel</p>
      <h1 class="text-4xl md:text-6xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">Walk Through 5,000 Years of Chinese History</h1>
      <p class="mt-6 text-lg md:text-xl text-warm-100/90 max-w-2xl leading-relaxed">Step-by-step guides to visit China's most remarkable archaeological sites — with real ticket prices, passport-tested booking instructions, and routes designed by someone who has walked every one of them.</p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a href="#sites" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 btn btn-primary text-base"><Landmark class="w-4 h-4" /> Browse Sites</a>
        <a href="#routes" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 btn btn-ghost-light text-base"><Route class="w-4 h-4" /> Plan Your Route</a>
      </div>
      <div class="mt-16 hidden md:block">
        <p class="text-xs text-warm-200/50 tracking-wide">SCROLL</p>
        <div class="mt-2 w-px h-8 bg-warm-200/30 mx-auto"></div>
      </div>
    </div>
  </section>

  <!-- Why This Site Exists -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <p class="text-sm font-medium tracking-wide text-accent/80 mb-3">Why This Site Exists</p>
    <p class="text-warm-700 leading-relaxed">
      In October 2024, Chinese archaeologists uncovered a <a href="#sites" class="text-accent font-medium hover:underline">5,000-year-old tomb in Henan</a> with 350 burial objects and nearly 200 jade artifacts. The discovery made global headlines. But when would-be visitors searched for how to go see it, they found nothing — only news articles that ended with a period. No museum opening hours. No ticket booking instructions. No answer to the simplest question: <em>"What ancient Chinese sites can I actually visit?"</em>
    </p>
    <p class="text-warm-700 leading-relaxed mt-4">
      This site is the answer. Eight extraordinary archaeological sites, all open to visitors. Real prices. Real routes. Every booking guide tested with a foreign passport. No generic travel-site filler — just the information you need to walk through 5,000 years of Chinese history yourself.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-2 text-xs text-muted">
      <span class="inline-block h-px w-6 bg-accent/40" aria-hidden="true"></span>
      Written by <strong class="text-warm-700 font-medium">Alex Chen</strong>
      <span aria-hidden="true">&middot;</span>
      Updated August 2026
      <span aria-hidden="true">&middot;</span>
      Every site visited firsthand
    </div>
  </section>

  <!-- Time Corridor -->
  <section id="timeline" class="py-16 max-w-[1200px] mx-auto px-6 reveal">
    <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 text-center">The Time Corridor</h2>
    <p class="text-center text-muted text-sm max-w-2xl mx-auto">From the dawn of Chinese civilization (6,300 years ago) to the Tang Dynasty (1,300 years ago) — three eras, at scale. Every site below is open to visitors today.</p>
    <div class="mt-12 overflow-x-auto pb-4">
      <div class="min-w-[560px] space-y-12">
        {eraTimeline.map((era) => (
          <div class="flex items-center gap-5 sm:gap-8">
            <div class="w-36 sm:w-44 shrink-0">
              <div class="flex items-center gap-2">
                <span class={`h-2.5 w-2.5 rounded-full ${era.dot}`} aria-hidden="true"></span>
                <span class="text-sm font-display font-semibold text-warm-900">{era.label}</span>
              </div>
              <p class="text-xs text-muted mt-1 whitespace-nowrap">{era.range}</p>
            </div>
            <div class="flex-1 relative h-32">
              <div class={`absolute left-0 right-0 top-1/2 -translate-y-1/2 h-1.5 rounded-full ${era.track}`} aria-hidden="true"></div>
              {era.sites.map((n) => (
                <a
                  href="#sites"
                  class="group absolute top-1/2 -translate-x-1/2 -translate-y-1/2"
                  style={`left:${n.pct}%`}
                >
                  <span class={`absolute left-1/2 top-1/2 h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full ring-2 ring-paper-50 ${era.dot}`} aria-hidden="true"></span>
                  {n.above ? (
                    <span class="absolute left-1/2 bottom-1/2 mb-5 -translate-x-1/2 text-center w-max">
                      <span class="block text-[13px] sm:text-sm font-semibold text-warm-900 group-hover:text-accent transition-colors">{n.site.name.split(' ')[0]}</span>
                      <span class="block text-xs text-muted">{n.site.yearsAgo.toLocaleString()} yr</span>
                    </span>
                  ) : (
                    <span class="absolute left-1/2 top-1/2 mt-5 -translate-x-1/2 text-center w-max">
                      <span class="block text-[13px] sm:text-sm font-semibold text-warm-900 group-hover:text-accent transition-colors">{n.site.name.split(' ')[0]}</span>
                      <span class="block text-xs text-muted">{n.site.yearsAgo.toLocaleString()} yr</span>
                    </span>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Site Cards -->
  <section id="sites" class="max-w-[1200px] mx-auto px-6 pb-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">Ancient Sites You Can Walk Through</h2>
        <p class="text-muted max-w-2xl reveal">Every site on this page has been visited, photographed, and documented firsthand. Ticket prices verified August 2026.</p>
      </div>
      <a href="#plan" class="hidden md:inline-flex items-center gap-2 text-sm text-accent hover:underline flex-shrink-0 ml-6">Plan your trip <ArrowRight class="w-4 h-4" /></a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {sites.map((site) => (
        <SiteCard {site} />
      ))}
    </div>
  </section>

  <!-- How to Use This Site -->
  <section class="bg-warm-50 py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 text-center reveal">How to Plan Your Trip</h2>
      <p class="text-muted mb-12 text-center max-w-xl mx-auto reveal">Three steps from curiosity to departure. Everything on this site is designed to move you forward.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="reveal text-center">
          <div class="w-12 h-12 rounded-full bg-accent/10 text-accent flex items-center justify-center mx-auto mb-4"><Map class="w-6 h-6" /></div>
          <h3 class="font-display font-semibold mb-2">Browse the Sites</h3>
          <p class="text-sm text-muted leading-relaxed">Pick a site from the cards above. Each guide tells you tickets, hours, how to get there, and — honestly — whether it is worth your time.</p>
        </div>
        <div class="reveal text-center">
          <div class="w-12 h-12 rounded-full bg-accent/10 text-accent flex items-center justify-center mx-auto mb-4"><Route class="w-6 h-6" /></div>
          <h3 class="font-display font-semibold mb-2">Pick a Route</h3>
          <p class="text-sm text-muted leading-relaxed">Not sure how to combine sites? Our ready-made itineraries handle the logistics — trains, hotels, and day-by-day timing.</p>
        </div>
        <div class="reveal text-center">
          <div class="w-12 h-12 rounded-full bg-accent/10 text-accent flex items-center justify-center mx-auto mb-4"><Ticket class="w-6 h-6" /></div>
          <h3 class="font-display font-semibold mb-2">Book &amp; Go</h3>
          <p class="text-sm text-muted leading-relaxed">Use our museum booking guides to secure tickets with a foreign passport. Then sort your visa, SIM card, and train tickets.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Route Cards -->
  <section id="routes" class="py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">Ready-Made Itineraries</h2>
      <p class="text-muted mb-10 max-w-2xl reveal">Don't know where to start? These routes combine the best sites into trips that actually work — realistic transit times, nearby hotels, and honest budgets.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="reveal card card-hover p-6 flex flex-col">
          <h3 class="font-display font-semibold text-lg leading-snug mb-2">Ancient China in 10 Days</h3>
          <p class="text-xs text-muted mb-4 leading-relaxed">The grand tour: four cities, three UNESCO sites, and 5,000 years of history. Designed to work as a visa-free transit trip.</p>
          <div class="flex flex-wrap gap-2 mb-4"><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Liangzhu</span><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Sanxingdui</span><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Terracotta Warriors</span><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Yin Xu</span></div>
          <div class="mt-auto flex items-center justify-between text-sm"><span class="text-muted">10 days &middot; 4 cities</span><span class="flex items-center gap-2"><span class="font-medium text-accent">~8,000-12,000 CNY</span><ArrowRight class="w-4 h-4 text-clay-400 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" /></span></div>
        </div>
        <div class="reveal card card-hover p-6 flex flex-col">
          <h3 class="font-display font-semibold text-lg leading-snug mb-2">Xi'an & Chengdu Ancient Sites</h3>
          <p class="text-xs text-muted mb-4 leading-relaxed">The ultimate Qin-Han-Shu route. Terracotta Warriors, Sanxingdui's bronze masks, and the tomb of China's only female emperor.</p>
          <div class="flex flex-wrap gap-2 mb-4"><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Terracotta Warriors</span><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Sanxingdui</span><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Han Yangling</span><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Qianling</span></div>
          <div class="mt-auto flex items-center justify-between text-sm"><span class="text-muted">7 days &middot; 2 cities</span><span class="flex items-center gap-2"><span class="font-medium text-accent">~5,000-8,000 CNY</span><ArrowRight class="w-4 h-4 text-clay-400 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" /></span></div>
        </div>
        <div class="reveal card card-hover p-6 flex flex-col">
          <h3 class="font-display font-semibold text-lg leading-snug mb-2">Henan Archaeology Tour</h3>
          <p class="text-xs text-muted mb-4 leading-relaxed">Walk the Shang Dynasty capital and see oracle bones where Chinese writing began. China's most underrated archaeology destination.</p>
          <div class="flex flex-wrap gap-2 mb-4"><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Yin Xu</span><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Longmen Grottoes</span><span class="text-xs px-2 py-1 rounded-full bg-warm-100 text-warm-700">Henan Museum</span></div>
          <div class="mt-auto flex items-center justify-between text-sm"><span class="text-muted">5 days &middot; 3 cities</span><span class="flex items-center gap-2"><span class="font-medium text-accent">~3,500-6,000 CNY</span><ArrowRight class="w-4 h-4 text-clay-400 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" /></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Map -->
  <section id="map" class="py-20 reveal">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="mb-8 flex items-end gap-4">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
          <MapPin class="w-5 h-5" />
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-1">Where Everything Is</h2>
          <p class="text-muted text-sm">All eight sites on one map &mdash; most connected by high-speed rail, the longest leg under 4 hours.</p>
        </div>
      </div>
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-stone-100 via-stone-50 to-amber-50/30 border border-stone-200/60 shadow-lg shadow-stone-200/40">
        <div class="aspect-[2/1] md:aspect-[3/1] relative">
          <div id="site-map" class="absolute inset-0 z-10" style="background:#f0efe7;"></div>
        </div>
      </div>
      <div class="mt-5 flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-muted">
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-accent/70"></span>Hangzhou</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-accent/70"></span>Chengdu</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-accent/70"></span>Anyang</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-accent/70"></span>Xi'an (3 sites)</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-accent/70"></span>Tai'an</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-accent/70"></span>Changsha</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-accent/70"></span>Qian County</span>
      </div>
    </div>
  </section>

  <!-- Trust Signals -->
  <section id="plan" class="max-w-[1200px] mx-auto px-6 py-20 reveal">
    <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2">Why Trust This Site</h2>
    <p class="text-muted mb-10 max-w-2xl">We know the bar is high for travel information you're going to act on. Here's how we meet it.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="border-t-2 border-accent pt-4"><div class="flex items-center gap-2 mb-2"><BadgeCheck class="w-5 h-5 text-accent flex-shrink-0" /><h3 class="font-semibold text-lg">Verified Prices</h3></div><p class="text-sm text-muted leading-relaxed">Every ticket price verified August 2026. We re-check quarterly and update when anything changes.</p></div>
      <div class="border-t-2 border-accent pt-4"><div class="flex items-center gap-2 mb-2"><ShieldCheck class="w-5 h-5 text-accent flex-shrink-0" /><h3 class="font-semibold text-lg">Passport Tested</h3></div><p class="text-sm text-muted leading-relaxed">Every museum booking guide has been tested with a foreign passport. No generic advice that doesn't actually work.</p></div>
      <div class="border-t-2 border-accent pt-4"><div class="flex items-center gap-2 mb-2"><Footprints class="w-5 h-5 text-accent flex-shrink-0" /><h3 class="font-semibold text-lg">Firsthand Visits</h3></div><p class="text-sm text-muted leading-relaxed">Written by someone who has visited every site on this page. Real photos, real routes, real experiences.</p></div>
      <div class="border-t-2 border-accent pt-4"><div class="flex items-center gap-2 mb-2"><Ban class="w-5 h-5 text-accent flex-shrink-0" /><h3 class="font-semibold text-lg">No AI Fluff</h3></div><p class="text-sm text-muted leading-relaxed">Every paragraph answers a real question a traveler would ask. No padding, no SEO filler, no recycled Wikipedia text.</p></div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="max-w-[800px] mx-auto px-6 py-20 reveal">
    <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 text-center">Frequently Asked Questions</h2>
    <p class="text-muted mb-10 text-center max-w-xl mx-auto">The questions travelers actually ask — answered with firsthand, passport-tested information.</p>
    <div class="space-y-3">
      {faqHomeSchema.mainEntity.map((item) => (
        <details class="card px-5 py-4 group open:border-accent/40 transition-colors">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none text-warm-900 font-medium text-sm md:text-base">
            {item.name}
            <ChevronDown class="w-4 h-4 text-clay-400 flex-shrink-0 group-open:rotate-180 transition-transform" />
          </summary>
          <p class="mt-3 text-sm text-warm-700 leading-relaxed">{item.acceptedAnswer.text}</p>
        </details>
      ))}
    </div>
  </section>

  <CTACard primaryHref="#sites" primaryLabel="Browse All Sites" secondaryHref="#plan" secondaryLabel="Plan Your Visit" />

  <RelatedLinks links={relatedLinks} />

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  (function() {
    var L = window.L;
    var map = document.getElementById('site-map');
    if (!map) return;
    function init() {
      if (typeof L === 'undefined') { setTimeout(init, 100); return; }
      var m = L.map(map, { scrollWheelZoom: false, zoomControl: true }).setView([34.0, 111.0], 5);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 18
      }).addTo(m);
      var sites = [
        {name:'Dawenkou Site', lat:35.9, lng:117.1},
        {name:'Liangzhu Ancient City', lat:30.39, lng:120.0},
        {name:'Sanxingdui', lat:30.99, lng:104.19},
        {name:'Yin Xu', lat:36.13, lng:114.31},
        {name:'Terracotta Warriors', lat:34.38, lng:109.27},
        {name:'Han Yangling Mausoleum', lat:34.44, lng:108.94},
        {name:'Mawangdui Han Tombs', lat:28.2, lng:112.97},
        {name:'Qianling Mausoleum', lat:34.57, lng:108.22}
      ];
      var icon = L.divIcon({className:'site-marker', html:'<div style=\'background:#c2410c;color:#fff;width:10px;height:10px;border-radius:50%;border:2px solid #fff;box-shadow:0 1px 3px rgba(0,0,0,.3)\'></div>', iconSize:[14,14], iconAnchor:[7,7]});
      sites.forEach(function(s) {
        L.marker([s.lat, s.lng], {icon:icon}).addTo(m).bindTooltip(s.name, {permanent:false, direction:'top', offset:[0,-8], className:'site-tooltip'});
      });
    }
    init();
  })();
</script>

</BaseLayout>