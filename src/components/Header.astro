---
import { Menu, X, ArrowRight, Landmark, ChevronDown } from '@lucide/astro';

const navLinks = [
  { label: 'Sites', href: '#sites' },
  { label: 'Guides', href: '#site-guides' },
  { label: 'Itineraries', href: '#routes' },
  { label: 'Plan', href: '#plan' },
  { label: 'About', href: '/about/' },
];

const guideLinks = [
  { label: 'Plan Your Trip', href: '/plan-your-trip/', desc: 'Booking, visa, trains, SIM & payments' },
  { label: 'Sanxingdui Guide', href: '/sanxingdui-guide/', desc: 'Tickets, transport & a 3-day plan' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/90 backdrop-blur-md">
  <nav class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="font-display text-lg font-semibold tracking-tight flex items-center gap-2.5 no-underline">
      <span class="w-7 h-7 rounded-lg bg-clay-600/10 text-clay-600 flex items-center justify-center"><Landmark class="w-4 h-4" /></span>
      Ancient China Travel
    </a>
    <ul class="hidden md:flex items-center gap-7">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium text-warm-700 hover:text-accent transition-colors duration-150"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="relative group">
        <button
          class="flex items-center gap-1 text-sm font-medium text-warm-700 hover:text-accent transition-colors duration-150"
          aria-haspopup="true"
        >
          Travel Guides <ChevronDown class="w-3.5 h-3.5" />
        </button>
        <div class="absolute left-1/2 -translate-x-1/2 top-full hidden pt-3 group-hover:block z-50">
          <div class="w-64 rounded-xl border border-border bg-surface shadow-lg p-2">
            {guideLinks.map(g => (
              <a href={g.href} class="block rounded-lg px-3 py-2 hover:bg-warm-50 transition-colors">
                <span class="block text-sm font-medium text-warm-900">{g.label}</span>
                <span class="block text-xs text-muted">{g.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </li>
    </ul>
    <a href="#plan" class="hidden lg:inline-flex items-center justify-center px-4 py-2 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors duration-150 shadow-[0_2px_8px_-3px_rgba(182,85,58,0.5)]">
      Plan a Trip
    </a>
    <button id="mobile-menu-btn" class="md:hidden text-warm-700 p-1" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <Menu id="menu-icon-open" class="w-6 h-6" />
      <X id="menu-icon-close" class="hidden w-6 h-6" />
    </button>
  </nav>
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-surface">
    <ul class="flex flex-col px-6 py-4 gap-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="block py-3 text-sm font-medium text-warm-700 hover:text-accent transition-colors duration-150"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-1">
        <p class="py-2 text-xs font-semibold uppercase tracking-wide text-muted">Travel Guides</p>
      </li>
      {guideLinks.map(g => (
        <li>
          <a
            href={g.href}
            class="block py-2 text-sm font-medium text-warm-700 hover:text-accent transition-colors duration-150"
          >
            {g.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a href="#plan" class="block py-3 text-sm font-semibold text-accent flex items-center gap-1.5">
          Plan a Trip <ArrowRight class="w-4 h-4" />
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden', !isOpen);
      iconClose.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>