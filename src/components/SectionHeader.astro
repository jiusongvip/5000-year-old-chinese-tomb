---
export interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  center?: boolean;
  dark?: boolean;
  headingLevel?: 'h1' | 'h2';
}

const { eyebrow, title, subtitle, center = false, dark = false, headingLevel = 'h1' } = Astro.props;
---

<div class={center ? 'text-center' : 'max-w-2xl'}>
  <p class={`flex items-center gap-3 text-xs font-semibold tracking-[0.2em] uppercase mb-4 ${center ? 'justify-center' : ''} ${dark ? 'text-clay-300' : 'text-accent'}`}>
    <span class={`inline-block w-8 h-px ${dark ? 'bg-clay-300/70' : 'bg-accent/50'}`}></span>
    {eyebrow}
  </p>
  {headingLevel === 'h1' ? (
    <h1 class={`font-display text-3xl md:text-4xl font-semibold leading-[1.08] tracking-tight ${dark ? 'text-white' : 'text-warm-900'}`}>{title}</h1>
  ) : (
    <h2 class={`font-display text-3xl md:text-4xl font-semibold leading-[1.08] tracking-tight ${dark ? 'text-white' : 'text-warm-900'}`}>{title}</h2>
  )}
  {subtitle && (
    <p class={`mt-3 leading-relaxed ${dark ? 'text-warm-200/80' : 'text-muted'}`}>{subtitle}</p>
  )}
</div>