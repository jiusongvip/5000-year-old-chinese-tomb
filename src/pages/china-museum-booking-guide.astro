---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTACard from '../components/CTACard.astro';
import { ExternalLink } from '@lucide/astro';
import { faqSchema } from '../data/schemas';

const title = 'How to Book Chinese Museum Tickets as a Foreigner';
const description = 'The universal method for booking Chinese museum tickets with a foreign passport — the WeChat mini-program flow, passport selection, payment options, and step-by-step guides for Sanxingdui, the Henan Museum, and the Shaanxi History Museum.';

const steps = [
  { title: 'Install WeChat and find the mini-program', text: 'Download WeChat and register. Search the museum\'s Chinese name in the search bar, filter to "Mini Programs", and open the official account. Look for the verified blue badge.' },
  { title: 'Choose "Individual Reservation"', text: 'On the mini-program home, tap 个人预约 (Individual Reservation). Do not use the group booking option. You will see a calendar; gray dates are sold out, blue dates are available.' },
  { title: 'Select "Passport" as your ID type', text: 'Open the ID type dropdown (证件类型) and scroll to 护照 (Passport). Enter your passport number exactly as printed — no spaces or dashes — and your name in the same order as your passport.' },
  { title: 'Pick a time slot and pay', text: 'Most museums offer morning (9:00–12:00) and afternoon (12:00–17:00) slots. Pay with WeChat Pay (link an international card in advance), or ask your hotel to pay and reimburse them.' },
  { title: 'Save the QR code and bring your passport', text: 'Screenshot the confirmation QR code immediately. At the museum, join the "Foreign Passport" lane and show your passport plus the QR code. A photo of your passport is not accepted.' },
];

const faqs = [
  { q: 'Which Chinese museums need advance booking?', a: 'Sanxingdui, the Shaanxi History Museum, the Henan Museum, and most major national museums require advance booking through WeChat mini-programs. The Terracotta Warriors, Liangzhu, Yin Xu, and Qianling sell tickets on-site. Museum booking windows are typically 7 days ahead.' },
  { q: 'Can I book Chinese museum tickets without WeChat?', a: 'Almost always no — the official systems run through WeChat mini-programs. Workarounds: book through a tour platform such as Klook or GetYourGuide that holds ticket blocks, ask your hotel front desk to book and pay, or have a Chinese friend book with cash reimbursement.' },
  { q: 'What if I do not have a Chinese phone number?', a: 'The WeChat mini-program generally requires a Chinese number to register. Buy a tourist SIM at the airport on arrival (¥100–200), use your hotel\'s front desk, or use a guided-tour booking that includes the ticket.' },
  { q: 'What happens if tickets are sold out?', a: 'Check back periodically — cancellations release sporadic tickets. Book through Klook or GetYourGuide, who sometimes hold pre-purchased tickets. Or shift your visit to a weekday outside Chinese holidays, when availability is far better.' },
  { q: 'Can I buy tickets at the museum entrance?', a: 'No for the booked-museum sites. Sanxingdui, the Shaanxi History Museum, and the Henan Museum do not sell at the door. Arriving without a reservation means you cannot enter. Book before you travel.' },
];

const schemaJson = JSON.stringify([faqSchema(faqs)]);

const relatedLinks = [
  { href: '/sanxingdui-museum-booking', label: 'how to book sanxingdui tickets' },
  { href: '/henan-museum-booking', label: 'henan museum booking foreigner' },
  { href: '/shaanxi-history-museum-booking', label: 'shaanxi history museum free tickets' },
  { href: '/china-sim-card-tourist', label: 'china sim card for tourists' },
  { href: '/faq', label: 'china travel faq' },
];
---

<BaseLayout {title} {description} schemaJson={schemaJson} author="Alex Chen" datePublished="2026-08-04" dateModified="2026-08-04" ogType="article">
  <section class="bg-warm-900 py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader
        eyebrow="Booking Guide"
        title={title}
        subtitle="One method works for almost every major Chinese museum: the WeChat mini-program. Here is the flow, the passport details, and the payment workarounds — tested with a foreign passport."
        dark
      />
      <div class="mt-8 flex flex-wrap gap-3">
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">Passport required</span>
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">7-day booking window</span>
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">WeChat mini-program</span>
      </div>
    </div>
  </section>

  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-8">The 5-Step Booking Flow</h2>
    <div class="space-y-6">
      {steps.map((s, i) => (
        <div class="card p-6 flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">{i + 1}</span>
          <div>
            <h3 class="font-semibold mb-1">{s.title}</h3>
            <p class="text-sm text-warm-700 leading-relaxed">{s.text}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-6 bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-800">
      <strong>Step 3 is where foreigners fail.</strong> If you select the Chinese ID card (身份证) instead of Passport (护照), the system will reject your number, and re-entering it mid-flow is tedious. Double-check "护照" before submitting. Mismatched names block entry at the gate.
    </div>
  </section>

  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Step-by-Step Museum Guides</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/sanxingdui-museum-booking" class="group card p-6 hover:border-clay-300 hover:shadow-sm transition-all duration-200 no-underline flex flex-col">
          <h3 class="font-display font-semibold mb-1">Sanxingdui Museum</h3>
          <p class="text-xs text-muted mb-3">¥72 · release 7 days ahead at 8:00 PM · sells out in minutes</p>
          <span class="mt-auto text-sm font-medium text-accent group-hover:underline">Booking guide &rarr;</span>
        </a>
        <a href="/shaanxi-history-museum-booking" class="group card p-6 hover:border-clay-300 hover:shadow-sm transition-all duration-200 no-underline flex flex-col">
          <h3 class="font-display font-semibold mb-1">Shaanxi History Museum</h3>
          <p class="text-xs text-muted mb-3">Free · release 7 days ahead at 10:00 AM &amp; 6:00 PM</p>
          <span class="mt-auto text-sm font-medium text-accent group-hover:underline">Booking guide &rarr;</span>
        </a>
        <a href="/henan-museum-booking" class="group card p-6 hover:border-clay-300 hover:shadow-sm transition-all duration-200 no-underline flex flex-col">
          <h3 class="font-display font-semibold mb-1">Henan Museum</h3>
          <p class="text-xs text-muted mb-3">Free · release 3–7 days ahead · easier for last-minute trips</p>
          <span class="mt-auto text-sm font-medium text-accent group-hover:underline">Booking guide &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-4">Stuck? Three Backup Plans</h2>
    <div class="space-y-4 text-sm text-warm-700">
      <div class="card p-5">
        <h3 class="font-semibold mb-1">1. Book through Klook or GetYourGuide</h3>
        <p>Tour platforms pre-purchase ticket blocks for Sanxingdui and other museums. You pay with an international card and receive instant confirmation — no WeChat, no mini-program. Book via <a href="https://www.klook.com" target="_blank" rel="nofollow sponsored" class="text-accent hover:underline inline-flex items-center gap-1 align-baseline">Klook <ExternalLink class="w-3 h-3 inline-block" /></a> or <a href="https://www.getyourguide.com" target="_blank" rel="nofollow sponsored" class="text-accent hover:underline inline-flex items-center gap-1 align-baseline">GetYourGuide <ExternalLink class="w-3 h-3 inline-block" /></a>.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-semibold mb-1">2. Ask your hotel front desk</h3>
        <p>Chinese hotel staff can book and pay on your behalf through their own WeChat. Hand over cash or transfer on arrival. This is the most reliable workaround and usually takes five minutes.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-semibold mb-1">3. Visit a site that does not need booking</h3>
        <p>If the museum tickets are gone, swap the day to a walk-in site — Liangzhu, Yin Xu, the Terracotta Warriors, or Han Yangling all sell at the door.</p>
      </div>
    </div>
  </section>

  <CTACard title="Ready to book your trip?" subtitle="Pair the booking guides with a visa check and you are ready to go." primaryHref="/china-240-hour-transit-visa" primaryLabel="Check the Visa Guide" secondaryHref="/ancient-china-10-day-itinerary" secondaryLabel="See the Itinerary" />

  <RelatedLinks links={relatedLinks} />
</BaseLayout>