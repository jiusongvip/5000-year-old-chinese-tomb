---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "How to Book Henan Museum Tickets as a Foreigner (2026 Step-by-Step)";
const description = "Step-by-step guide for foreigners to book Henan Museum (Zhengzhou) tickets with a passport. Free entry but requires WeChat reservation. Updated August 2026.";

const howToSchema = {
  "@type": "HowTo",
  "name": "How to Book Henan Museum Tickets with a Foreign Passport",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Open WeChat and search for the mini-program", "text": "Open WeChat, search for “河南博物院” (Henan Museum). Select the official mini-program with the museum logo and verified badge." },
    { "@type": "HowToStep", "position": 2, "name": "Select visit date", "text": "Tap “参观预约” (Visit Reservation). Choose your date from the calendar. Tickets are released 3 days in advance." },
    { "@type": "HowToStep", "position": 3, "name": "Enter passport information", "text": "Select “护照” (Passport) as your ID type. Enter your passport number and name exactly as on your passport. Enter a contact phone number." },
    { "@type": "HowToStep", "position": 4, "name": "Confirm and save", "text": "Submit the reservation (no payment needed — entry is free). Screenshot the QR code confirmation. Bring your passport to the museum entrance." },
  ],
  "totalTime": "PT5M"
};

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", "name": "Is Henan Museum free for foreigners?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, Henan Museum is free for all visitors. You only need to make an online reservation through WeChat with your passport details. No payment is required." } },
    { "@type": "Question", "name": "When are Henan Museum tickets released?", "acceptedAnswer": { "@type": "Answer", "text": "Tickets (reservations) are released 3 days in advance. The museum is less competitive than Sanxingdui or the Shaanxi History Museum, so getting a reservation is usually straightforward outside of major holidays." } },
    { "@type": "Question", "name": "Is Henan Museum worth visiting?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, absolutely. Henan Museum is one of China’s best provincial museums, with extraordinary collections from the Shang and Zhou dynasties, including oracle bones, bronze ritual vessels, and the famous “Jiahu bone flute” — one of the oldest playable musical instruments in the world at 9,000 years old." } },
    { "@type": "Question", "name": "What are the opening hours of Henan Museum?", "acceptedAnswer": { "@type": "Answer", "text": "Henan Museum is open Tuesday through Sunday, 9:00–17:00 (last entry 16:00). It is closed on Mondays. Check the official WeChat account for holiday schedules." } },
  ],
};

const schemaJson = JSON.stringify([howToSchema, faqSchema,
{
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://5000-year-old-chinese-tomb.com" },
      { "@type": "ListItem", "position": 2, "name": "Henan Museum Booking", "item": "https://5000-year-old-chinese-tomb.com/henan-museum-booking" }
    ]
  },
]);
---

<BaseLayout {title} {description} schemaJson={schemaJson} lastUpdated="August 4, 2026">
  <slot name="head">
    <meta property="og:image" content="https://5000-year-old-chinese-tomb.com/og-booking-henan.webp" />
  </slot>

  <!-- Hero -->
  <section class="bg-warm-900 py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <p class="text-sm font-medium tracking-wide text-accent/80 mb-4">Booking Guide</p>
      <h1 class="text-3xl md:text-5xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">How to Book Henan Museum Tickets</h1>
      <p class="mt-4 text-lg text-warm-200/80 max-w-2xl leading-relaxed">Free entry, but you need a WeChat reservation. How foreigners can book Henan Museum in Zhengzhou with a passport — simple, fast, and one of China’s best museums.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">Free entry</span>
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">3 days in advance</span>
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">Closed Mondays</span>
      </div>
    </div>
  </section>

  <!-- Basic Info -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-4">Quick Facts</h2>
    <div class="bg-white rounded-lg border border-border p-6 space-y-3 text-sm">
      <div class="flex justify-between py-1.5 border-b border-border/50"><span class="text-muted">Price</span><span class="font-semibold text-warm-900">Free</span></div>
      <div class="flex justify-between py-1.5 border-b border-border/50"><span class="text-muted">Reservation window</span><span class="font-semibold text-warm-900">3 days in advance</span></div>
      <div class="flex justify-between py-1.5 border-b border-border/50"><span class="text-muted">Opening hours</span><span class="font-semibold text-warm-900">9:00–17:00, last entry 16:00</span></div>
      <div class="flex justify-between py-1.5"><span class="text-muted">Booking method</span><span class="font-semibold text-warm-900">WeChat mini-program</span></div>
    </div>
  </section>

  <!-- Step by Step -->
  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-8">Step-by-Step Booking</h2>

      <div class="space-y-6">
        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">1</span>
          <div>
            <h3 class="font-semibold mb-1">Open WeChat and find Henan Museum</h3>
            <p class="text-sm text-warm-700 leading-relaxed">Open WeChat, search for <strong>河南博物院</strong> (Henan Museum). Select the official mini-program with the verified badge. The museum has both a subscription account (公众号) and a mini-program (小程序) — you want the mini-program for booking.</p>
          </div>
        </div>
        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">2</span>
          <div>
            <h3 class="font-semibold mb-1">Select reservation</h3>
            <p class="text-sm text-warm-700 leading-relaxed">Tap <strong>参观预约</strong> (Visit Reservation). You will see a calendar. Blue dates are available, gray are sold out. Henan Museum rarely sells out outside of holidays, so booking 1–2 days ahead is usually fine.</p>
          </div>
        </div>
        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">3</span>
          <div>
            <h3 class="font-semibold mb-1">Enter passport details</h3>
            <p class="text-sm text-warm-700 leading-relaxed">In the ID type field, select <strong>护照</strong> (Passport). Enter your passport number and full name. Enter a contact phone number (Chinese or international). No payment is required — the museum is free.</p>
          </div>
        </div>
        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">4</span>
          <div>
            <h3 class="font-semibold mb-1">Save and arrive</h3>
            <p class="text-sm text-warm-700 leading-relaxed">Screenshot the confirmation QR code. At the museum, go to the entrance with your passport and the QR code. Foreign visitors may be directed to a separate lane. The museum is at 8 Nongye Road, Jinshui District, Zhengzhou — a 15-minute taxi from Zhengzhou East Station.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Visit -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Why Visit Henan Museum</h2>
    <div class="space-y-4 text-sm text-warm-700 leading-relaxed">
      <p>Henan Province is the heartland of early Chinese civilization, and this museum holds its greatest treasures. With over 170,000 artifacts, it is one of China’s “big three” provincial museums alongside Shaanxi History Museum and Nanjing Museum.</p>
      <p>Highlights include: the <strong>Jiahu bone flutes</strong> (9,000 years old, the oldest playable musical instruments in the world), Shang Dynasty oracle bones, the largest collection of Zhou Dynasty bronze ritual vessels anywhere, and exquisite Tang Dynasty sancai (three-color) glazed pottery.</p>
      <p>The museum is the perfect companion to a visit to Yin Xu in Anyang (40 minutes by train from Zhengzhou). Start at the museum to understand the broader context, then visit the excavation site to see where the artifacts were found.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-warm-900 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <h2 class="text-xl font-display font-semibold tracking-tight text-white mb-4">Pair the museum with Yin Xu</h2>
      <p class="text-warm-200 max-w-lg mx-auto mb-8">Henan Museum in Zhengzhou and Yin Xu in Anyang make a perfect two-day archaeology deep dive. Both on our Henan tour.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/yin-xu-anyang" class="inline-flex items-center justify-center px-8 py-3.5 bg-accent text-white font-medium rounded-lg hover:bg-accent-dark active:scale-[0.98] transition-all duration-150">Yin Xu Site Guide</a>
        <a href="/henan-archaeology-tour" class="inline-flex items-center justify-center px-8 py-3.5 border border-white/40 text-white font-medium rounded-lg hover:bg-white/10 active:scale-[0.98] transition-all duration-150">Henan Archaeology Tour</a>
      </div>
    </div>
  </section>
</BaseLayout>
