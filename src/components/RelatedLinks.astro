---
export interface Props {
  title?: string;
  links: { href: string; label: string }[];
}

const { title = 'People also search for', links = [] } = Astro.props;
---

<section class="py-12 md:py-16 border-t border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="flex items-center gap-3 mb-4">
      <span class="inline-block h-px w-8 bg-accent/50"></span>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent">Related Searches</p>
    </div>
    <h2 class="font-display text-2xl md:text-3xl font-semibold text-warm-900 mb-6">{title}</h2>
    <div class="flex flex-wrap gap-3 max-w-3xl">
      {links.map((l) => (
        <a
          href={l.href}
          class="px-4 py-2 border border-border rounded-full text-sm text-warm-700 hover:text-accent hover:border-clay-300 hover:bg-clay-50/60 transition"
        >
          {l.label}
        </a>
      ))}
    </div>
  </div>
</section>