---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Privacy Policy, Cookies & Data';
const description =
  'How Ancient China Travel handles data, cookies, and third-party services. This site collects no personal information from visitors. No tracking, no ad trackers.';
const dateModified = '2026-09-02';
---

<BaseLayout {title} {description} lastUpdated={dateModified}>
  <section class="max-w-[800px] mx-auto px-6 py-16">
    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent mb-3">Privacy Policy</p>
    <h1 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-warm-900 mb-3">Privacy Policy</h1>
    <p class="text-xs text-muted mb-10">Last updated: September 2, 2026</p>

    <div class="space-y-10 text-sm text-warm-700 leading-relaxed">
      <section>
        <h2 class="font-display text-xl font-semibold text-warm-900 mb-3">Who we are</h2>
        <p>
          Ancient China Travel (ancientchinatravel.com) publishes independent, firsthand guides for visiting
          ancient Chinese archaeological sites. We are a static informational website. You can reach us at
          <a href="mailto:hello@ancientchinatravel.com" class="text-accent hover:underline">hello@ancientchinatravel.com</a>.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl font-semibold text-warm-900 mb-3">What we collect</h2>
        <p>We do not collect, store, or process any personal information about our visitors.</p>
        <ul class="mt-3 list-disc pl-5 space-y-2">
          <li>No account registration, no forms, and no comments — we never ask for your name, email, or phone number on this site.</li>
          <li>No cookies are set by this website itself.</li>
          <li>We run no analytics or advertising trackers that identify individual visitors.</li>
        </ul>
      </section>

      <section>
        <h2 class="font-display text-xl font-semibold text-warm-900 mb-3">Hosting and edge logs</h2>
        <p>
          This site is hosted on Cloudflare Pages. Like any web host, Cloudflare may process standard server
          logs (such as IP address, user-agent, and requested URL) for security and to keep the site running.
          Cloudflare may also set technical cookies required for its edge services. This data is used by
          Cloudflare under its own privacy policy, not by us.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl font-semibold text-warm-900 mb-3">Third-party services</h2>
        <p>The interactive map on our homepage loads resources from the following third parties:</p>
        <ul class="mt-3 list-disc pl-5 space-y-2">
          <li><strong>Leaflet</strong> (via unpkg.com) — the open-source JavaScript library that powers the map. Loading it may send your IP address to unpkg.com.</li>
          <li><strong>OpenStreetMap</strong> (tile.openstreetmap.org) — map tiles. Loading tiles may send your IP address and the map region you view to OpenStreetMap, which has its own privacy policy.</li>
        </ul>
        <p class="mt-3">All fonts are self-hosted on our own server; we send no font-related requests to third parties.</p>
      </section>

      <section>
        <h2 class="font-display text-xl font-semibold text-warm-900 mb-3">External links</h2>
        <p>
          Some pages link to external websites (museum sites, Wikipedia, and other references). We are not
          responsible for the privacy practices of those sites.
        </p>
      </section>

      <section>
        <h2 class="font-display text-xl font-semibold text-warm-900 mb-3">Contact</h2>
        <p>
          If you have any questions about this policy, email
          <a href="mailto:hello@ancientchinatravel.com" class="text-accent hover:underline">hello@ancientchinatravel.com</a>.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>
