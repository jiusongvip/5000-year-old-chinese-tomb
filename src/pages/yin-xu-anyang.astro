---
import BaseLayout from "../layouts/BaseLayout.astro";
import AttractionSchema from "../components/AttractionSchema.astro";

const title = "Yin Xu (Anyang) Guide 2026: Tickets, Hours & How to Get There";
const description = "Complete guide to Yin Xu, the 3,300-year-old Shang Dynasty capital and UNESCO World Heritage Site. Oracle bones, royal tombs, tickets ¥90. How to get there from Zhengzhou and Beijing.";

const faqs = [
  { q: "How do I get to Yin Xu from Zhengzhou?", a: "Take a high-speed train from Zhengzhou East to Anyang East Station (40–50 minutes, ¥80–120). From Anyang East, take a taxi to Yin Xu (20 minutes, ¥30). Trains run frequently throughout the day." },
  { q: "Is Yin Xu worth visiting?", a: "Yes, if you are interested in Chinese history. Yin Xu is where oracle bones — the earliest known Chinese writing — were discovered in 1899. The new museum (opened 2024) is outstanding, and the site receives few international tourists, making for an uncrowded experience." },
  { q: "What are oracle bones?", a: "Oracle bones are turtle shells and animal bones used for divination by Shang Dynasty kings. Questions about warfare, harvests, and royal hunts were carved onto the bones, which were then heated until they cracked. The cracks were interpreted as answers from ancestors. These inscriptions are the earliest known form of Chinese writing, dating to around 1250 BCE." },
  { q: "Can I visit the actual excavation pits at Yin Xu?", a: "Yes. The Yin Xu site includes the excavated foundations of palaces and temples, royal tombs, and chariot burial pits. The famous Tomb of Fu Hao (Lady Hao) is preserved in situ and can be viewed. The new museum displays thousands of bronze vessels, jade objects, and oracle bones from the site." },
  { q: "How old is Yin Xu?", a: "Yin Xu served as the capital of the Shang Dynasty from approximately 1300 to 1046 BCE, making it roughly 3,300 years old. It is the earliest Chinese capital city confirmed by both archaeological evidence and contemporaneous written records." },
];
---

<BaseLayout {title} {description} author="Alex Chen" datePublished="2026-08-04" dateModified="2026-08-04">
  <Fragment slot="head">
    <AttractionSchema slug="yin-xu-anyang" faqs={faqs} />
  </Fragment>

  <!-- Hero -->
  <section class="relative min-h-[40dvh] flex items-center overflow-hidden bg-warm-900">
    <div class="absolute inset-0 z-0 opacity-25">
      <img src="/og-yinxu.webp" alt="Yin Xu" width="1200" height="630" class="w-full h-full object-cover" loading="eager" />
    </div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-20">
      <p class="text-sm font-medium tracking-wide text-accent/80 mb-4">Site Guide &middot; 3,300 Years Old &middot; UNESCO 2006</p>
      <h1 class="text-3xl md:text-5xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">Yin Xu</h1>
      <p class="mt-4 text-lg text-warm-200/80 max-w-2xl leading-relaxed">The capital where Chinese writing was born. Walk through the ruins of the Shang Dynasty’s last capital — royal tombs, chariot pits, and the oracle bones that recorded the earliest known Chinese script.</p>
    </div>
  </section>

  <!-- Overview -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Overview</h2>
    <div class="space-y-4 text-warm-700 leading-relaxed">
      <p>
        Yin Xu (<span lang="zh">殷墟</span>) is the archaeological site of the last capital of the Shang Dynasty, which ruled the Yellow River valley from approximately 1300 to 1046 BCE. Located on the outskirts of modern Anyang in Henan Province, it is the earliest Chinese capital confirmed by both archaeology and contemporaneous written records.
      </p>
      <p>
        The site became famous in 1899 when scholars recognized that the “dragon bones” sold in traditional medicine shops were actually inscribed turtle shells and cattle scapulae bearing the oldest known Chinese writing. These <strong>oracle bones</strong> (jiaguwen, <span lang="zh">甲骨文</span>) recorded divinations performed for Shang kings — questions about warfare, weather, harvests, and royal hunts. Over 150,000 fragments have been recovered, and they form the foundation of Chinese paleography.
      </p>
      <p>
        In 2024, a brand-new museum opened at Yin Xu, dramatically expanding the exhibition space and bringing world-class display standards to the site. The museum houses thousands of bronze ritual vessels, jade carvings, and the most important oracle bone collections. The outdoor areas include the excavated palace-temple complex, the royal cemetery, and the Tomb of Fu Hao — the only undisturbed Shang royal tomb ever found.
      </p>
    </div>
  </section>

  <!-- Key Facts -->
  <section class="bg-warm-50 py-12 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-xl font-display font-semibold tracking-tight mb-6">Key Facts</h2>
      <div class="card overflow-hidden">
        <dl class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-border/50">
          <div class="flex justify-between sm:flex-col px-6 py-3.5 sm:gap-1"><dt class="text-xs text-muted font-medium">Tickets</dt><dd class="text-sm font-semibold text-warm-900">¥90</dd></div>
          <div class="flex justify-between sm:flex-col px-6 py-3.5 sm:gap-1"><dt class="text-xs text-muted font-medium">Opening Hours</dt><dd class="text-sm font-semibold text-warm-900">8:00–18:30 (winter 8:00–17:30)</dd></div>
          <div class="flex justify-between sm:flex-col px-6 py-3.5 sm:gap-1"><dt class="text-xs text-muted font-medium">Suggested Time</dt><dd class="text-sm font-semibold text-warm-900">3–4 hours</dd></div>
          <div class="flex justify-between sm:flex-col px-6 py-3.5 sm:gap-1"><dt class="text-xs text-muted font-medium">Location</dt><dd class="text-sm font-semibold text-warm-900">Anyang, Henan Province</dd></div>
          <div class="flex justify-between sm:flex-col px-6 py-3.5 sm:gap-1"><dt class="text-xs text-muted font-medium">Culture</dt><dd class="text-sm font-semibold text-warm-900">Shang Dynasty (Bronze Age)</dd></div>
          <div class="flex justify-between sm:flex-col px-6 py-3.5 sm:gap-1"><dt class="text-xs text-muted font-medium">New Museum</dt><dd class="text-sm font-semibold text-warm-900">Opened 2024</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- How to Get There -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">How to Get There</h2>
    <div class="space-y-6 text-warm-700 leading-relaxed">
      <div>
        <h3 class="font-semibold text-lg mb-2">From Zhengzhou (best option)</h3>
        <p class="text-sm">High-speed train from Zhengzhou East to Anyang East Station: 40–50 minutes, ¥80–120 second class, trains every 20–30 minutes. From Anyang East, take a taxi directly to Yin Xu (20 minutes, approximately ¥30).</p>
      </div>
      <div>
        <h3 class="font-semibold text-lg mb-2">From Beijing</h3>
        <p class="text-sm">High-speed train from Beijing West to Anyang East: approximately 2 hours, ¥200–250. Yin Xu is feasible as a long day trip from Beijing if you catch an early train (depart 7:00 AM, return 6:00 PM).</p>
      </div>
      <div>
        <h3 class="font-semibold text-lg mb-2">From Luoyang</h3>
        <p class="text-sm">High-speed train from Luoyang Longmen to Anyang East: approximately 1.5 hours, ¥120–180. Combine Yin Xu with the Longmen Grottoes (UNESCO) for a rich two-day Henan archaeology trip.</p>
      </div>
    </div>
  </section>

  <!-- Is It Worth Visiting -->
  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Is It Worth Visiting?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 class="font-semibold text-green-700 mb-3">Pros</h3>
          <ul class="space-y-2 text-sm text-warm-700">
            <li>• Where Chinese writing was born — unparalleled historical significance</li>
            <li>• Brand-new museum (2024) with world-class exhibitions</li>
            <li>• See the tomb of Fu Hao, the only intact Shang royal burial</li>
            <li>• Virtually no international tourists — you may have rooms to yourself</li>
            <li>• Good high-speed train connections from major cities</li>
          </ul>
        </div>
        <div class="card p-6">
          <h3 class="font-semibold text-red-700 mb-3">Cons</h3>
          <ul class="space-y-2 text-sm text-warm-700">
            <li>• Anyang is a smaller city with fewer hotel and dining options</li>
            <li>• Limited English signage outside the new museum</li>
            <li>• Outdoor areas are exposed — hot in summer, cold in winter</li>
            <li>• Some taxi drivers may not know the new museum entrance</li>
          </ul>
        </div>
      </div>
      <p class="mt-6 text-sm text-warm-700 text-center">Best for: serious history enthusiasts, students of Chinese language and culture, and travellers who want to see the roots of Chinese civilization without the crowds.</p>
    </div>
  </section>

  <!-- Nearby -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Nearby Hotels & Attractions</h2>
    <div class="space-y-4 text-sm text-warm-700">
      <p><strong>Hotels:</strong> Anyang has mid-range hotels from ¥200/night near the railway station. The Anyang Guesthouse near the city center is a comfortable option. For more choice, stay in Zhengzhou (40 minutes by train) and do Yin Xu as a day trip.</p>
      <p><strong>What else is nearby:</strong> The National Museum of Chinese Writing (in Anyang, a must-see companion to Yin Xu), the Red Flag Canal (a dramatic engineering feat), and the Longmen Grottoes in Luoyang (UNESCO, 1.5 hours by train).</p>
    </div>
  </section>

  

  <!-- What You Will See -->
  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">What You Will See</h2>
      <div class="space-y-6 text-warm-700 leading-relaxed">
        <div>
          <h3 class="font-semibold text-lg mb-2">The New Yin Xu Museum (opened 2024)</h3>
          <p class="text-sm">The centerpiece. A massive upgrade from the old museum, the new building displays thousands of bronze vessels, jade carvings, and — critically — oracle bones with English translations. The galleries trace the Shang Dynasty from its founding to its fall, with dedicated sections on bronze casting, chariot warfare, and ritual sacrifice. Budget at least 2 hours here alone. The lighting and curation are world-class.</p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">The Oracle Bone Archive</h3>
          <p class="text-sm">This is the reason scholars come here. Yin Xu has yielded over 150,000 oracle bones — turtle plastrons and ox scapulae inscribed with the earliest known Chinese writing. The questions carved into them are surprisingly personal: "Will the king's toothache stop?" "Is it auspicious to hunt tomorrow?" "Will the queen give birth on a lucky day?" Seeing the actual bones with their tiny carved characters — each one a direct message from 3,300 years ago — is one of the most intimate archaeological experiences in the world.</p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">The Tomb of Fu Hao (Lady Hao)</h3>
          <p class="text-sm">The only undisturbed royal Shang tomb ever found. Fu Hao was a consort of King Wu Ding but also a military general who led 13,000 troops into battle — one of the earliest documented female military commanders in history. Her tomb contained 1,600 kg of bronze vessels, 755 jade objects, and 6,900 cowrie shells (Shang currency). The tomb pit is preserved in situ, and you can stand at its edge. Most of the objects are in the museum.</p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">The Palace-Temple Area and Chariot Pits</h3>
          <p class="text-sm">The foundations of Shang Dynasty palaces and temples are visible as raised earth platforms with explanatory signs. Nearby, several chariot burial pits show horses and chariots interred with their owners — a practice that originated on the Eurasian steppe and was adopted by the Shang elite. The skeletons have been left in place.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Insider Tips -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Insider Tips</h2>
    <div class="space-y-4 text-sm text-warm-700 leading-relaxed">
      <div class="card p-5">
        <h3 class="font-semibold mb-2">Start at the National Museum of Chinese Writing first</h3>
        <p>Visit this museum (Zhongguo Wenzi Bowuguan) in downtown Anyang <em>before</em> Yin Xu. It explains the evolution of Chinese characters from oracle bones to modern script with excellent English displays. Then when you see the oracle bones at Yin Xu, you will actually understand what you are looking at. Open 9:00–17:00, free, closed Mondays.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-semibold mb-2">Anyang is very few foreign tourists — be prepared</h3>
        <p>Unlike Xi'an or Chengdu, Anyang has almost no English infrastructure. Menus are Chinese-only. Hotel staff rarely speak English. Download an offline translation app and save the Chinese names of your destinations. This is part of the appeal — you are not on the tourist trail — but it requires preparation.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-semibold mb-2">Combine with the Anyang Museum (free, downtown)</h3>
        <p>The city museum has a smaller but well-organized collection of Shang artifacts and offers a broader view of Anyang's history. It is a good complement to Yin Xu and takes about an hour. Free entry, open 9:00–17:00, closed Mondays.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-warm-900 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <h2 class="text-xl md:text-2xl font-display font-semibold tracking-tight text-white mb-4">Explore Yin Xu on an archaeology tour</h2>
      <p class="text-warm-200 max-w-lg mx-auto mb-8">Yin Xu is the anchor of our Henan Archaeology Tour — a 3-city, 5-day journey through the heartland of early Chinese civilization.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/henan-archaeology-tour" class="inline-flex items-center justify-center px-8 py-3.5 btn btn-primary">Henan Archaeology Tour</a>
        <a href="/ancient-china-10-day-itinerary" class="inline-flex items-center justify-center px-8 py-3.5 btn btn-ghost-light">10-Day Itinerary</a>
      </div>
    </div>
  </section>
</BaseLayout>
