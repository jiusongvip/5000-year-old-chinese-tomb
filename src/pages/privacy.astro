---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy";
const description = "Privacy policy for Ancient China Travel. How we handle your data, cookies, and contact information.";

const schemaJson = JSON.stringify([
  { "@type": "WebPage", "name": "Privacy Policy", "url": "https://5000-year-old-chinese-tomb.com/privacy" },
]);
---

<BaseLayout {title} {description} schemaJson={schemaJson}>

  <section class="bg-warm-900 py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <p class="text-sm font-medium tracking-wide text-accent/80 mb-4">Legal</p>
      <h1 class="text-3xl md:text-5xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">Privacy Policy</h1>
      <p class="mt-4 text-lg text-warm-200/80 max-w-2xl">How we handle your privacy. Last updated August 4, 2026.</p>
    </div>
  </section>

  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <div class="space-y-8 text-warm-700 leading-relaxed text-sm">
      <div>
        <h2 class="text-xl font-display font-semibold tracking-tight text-warm-900 mb-4">Our Approach to Privacy</h2>
        <p>Ancient China Travel is a static website. We do not run analytics scripts, tracking cookies, advertising networks, or any third-party services that collect personal data. We do not have user accounts, comment systems, or newsletter forms.</p>
        <p class="mt-2">This means: when you browse this site, nobody is watching. No data is sent to Google, Facebook, or any analytics provider. Your reading behavior is your own business.</p>
      </div>

      <div>
        <h2 class="text-xl font-display font-semibold tracking-tight text-warm-900 mb-4">What We Collect</h2>
        <p><strong>Email correspondence.</strong> If you email us at hello@5000-year-old-chinese-tomb.com, we receive your email address and whatever information you choose to include in your message. We use this solely to respond to your inquiry and do not add your address to any mailing list. We do not share your email with anyone.</p>
        <p class="mt-2"><strong>Server logs.</strong> Our hosting provider (Cloudflare Pages) may maintain standard server access logs, which include IP addresses, timestamps, and pages visited. These are standard technical logs required for operating a website and are not used by us for tracking or profiling.</p>
      </div>

      <div>
        <h2 class="text-xl font-display font-semibold tracking-tight text-warm-900 mb-4">Cookies</h2>
        <p>This site does not set any cookies. There are no tracking cookies, session cookies, or functional cookies of any kind.</p>
      </div>

      <div>
        <h2 class="text-xl font-display font-semibold tracking-tight text-warm-900 mb-4">Third-Party Services</h2>
        <p>Our interactive map on the homepage uses OpenStreetMap tiles and the Leaflet library, loaded from unpkg.com. OpenStreetMap and unpkg may set their own cookies or log IP addresses. Their privacy practices are governed by their own policies:</p>
        <ul class="list-disc list-inside mt-2 space-y-1">
          <li>OpenStreetMap Foundation: <a href="https://wiki.osmfoundation.org/wiki/Privacy_Policy" class="text-accent hover:underline">Privacy Policy</a></li>
          <li>Leaflet/unpkg: <a href="https://unpkg.com/" class="text-accent hover:underline">unpkg.com</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-display font-semibold tracking-tight text-warm-900 mb-4">Your Rights</h2>
        <p>Since we do not collect or store personal data, there is effectively no data to access, correct, or delete. If you have emailed us and would like us to delete your correspondence, simply reply asking us to do so and we will remove it.</p>
      </div>

      <div>
        <h2 class="text-xl font-display font-semibold tracking-tight text-warm-900 mb-4">Contact</h2>
        <p>Questions about this policy? Email us at <a href="mailto:hello@5000-year-old-chinese-tomb.com" class="text-accent hover:underline">hello@5000-year-old-chinese-tomb.com</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
