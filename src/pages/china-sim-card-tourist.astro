---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "China SIM Card for Tourists: Complete 2026 Guide";
const description = "How to get a Chinese SIM card or eSIM as a foreign tourist. Options at the airport, buying in the city, eSIM alternatives, and why you need a Chinese phone number for museum bookings.";

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", "name": "Do I need a Chinese phone number to travel in China?", "acceptedAnswer": { "@type": "Answer", "text": "A Chinese phone number is not strictly required but is highly recommended. Many museum booking systems (WeChat mini-programs), food delivery apps, and bike-sharing services require a Chinese number. Without one, you will need to rely on hotel staff or tour agencies for bookings." } },
    { "@type": "Question", "name": "Where can I buy a Chinese SIM card as a foreigner?", "acceptedAnswer": { "@type": "Answer", "text": "You can buy a SIM card at the airport on arrival (most convenient), at official China Mobile/China Unicom/China Telecom stores in the city (cheapest), or through online pre-order for airport pickup. Bring your passport — it is required for SIM card registration." } },
    { "@type": "Question", "name": "What about eSIM alternatives?", "acceptedAnswer": { "@type": "Answer", "text": "eSIM services like Airalo, Holafly, and Nomad offer data-only plans for China that work with foreign phones. These are convenient for internet access but do not provide a Chinese phone number. You will still need a workaround for museum bookings that require a phone number." } },
    { "@type": "Question", "name": "How much does a Chinese SIM card cost?", "acceptedAnswer": { "@type": "Answer", "text": "A tourist SIM card costs approximately ¥100–200 for a 7–15 day plan with 20–50 GB of data and a Chinese phone number. eSIM data-only plans are slightly cheaper (¥50–150 for similar data) but without a phone number." } },
  ],
};

const schemaJson = JSON.stringify([faqSchema]);
---

<BaseLayout {title} {description} schemaJson={schemaJson} author="Alex Chen" datePublished="2026-08-04" dateModified="2026-08-04">

  <section class="bg-warm-900 py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <p class="text-sm font-medium tracking-wide text-accent/80 mb-4">Practical Guide</p>
      <h1 class="text-3xl md:text-5xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">Getting a Chinese SIM Card as a Tourist</h1>
      <p class="mt-4 text-lg text-warm-200/80 max-w-2xl leading-relaxed">Physical SIM vs eSIM, where to buy, costs, and why a Chinese phone number makes museum bookings and daily life dramatically easier.</p>
    </div>
  </section>

  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Option 1: Buy a SIM at the Airport (Recommended)</h2>
    <div class="space-y-4 text-sm text-warm-700 leading-relaxed">
      <p>The easiest option. After clearing customs at major airports (Beijing, Shanghai, Hangzhou, Chengdu, Xi’an), you will find China Mobile, China Unicom, and China Telecom kiosks in the arrivals hall. Staff at larger airports speak basic English.</p>
      <p>Ask for a <strong>“tourist SIM”</strong> or <strong>“short-term plan.”</strong> You will need your passport. Plans typically include 20–50 GB of data plus a Chinese phone number for ¥100–200, valid for 7–30 days. The SIM is activated immediately.</p>
    </div>
  </section>

  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Option 2: eSIM (Data-Only, No Phone Number)</h2>
      <p class="text-sm text-warm-700 leading-relaxed mb-6">eSIM services like Airalo, Holafly, and Nomad offer data-only plans for China. They are convenient — you install them before you fly and have internet the moment you land, no passport registration required. <strong>However, they do not provide a Chinese phone number.</strong> You will not be able to use WeChat mini-programs that require a phone number for registration.</p>
      <div class="card p-5 text-sm text-warm-700">
        <strong>Workaround:</strong> Use an eSIM for internet and ask your hotel front desk to help with museum bookings that require a phone number. Most hotels are happy to do this. This is the simplest combination for short trips.
      </div>
    </div>
  </section>

  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Why a Chinese Phone Number Matters for This Trip</h2>
    <div class="space-y-3 text-sm text-warm-700">
      <p>Several museum booking systems on our site require a Chinese phone number:</p>
      <ul class="list-disc list-inside space-y-1">
        <li><strong>Sanxingdui Museum</strong> — WeChat booking requires a phone number</li>
        <li><strong>Shaanxi History Museum</strong> — Phone number required for reservation</li>
        <li><strong>Henan Museum</strong> — Phone number required for free ticket booking</li>
      </ul>
      <p class="mt-4">Without a Chinese number, you can still book through Klook/GetYourGuide or ask your hotel for help. But having your own number gives you independence and is worth the ¥100–200 investment for trips of 7+ days.</p>
    </div>
  </section>

  <section class="bg-warm-900 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <h2 class="text-xl font-display font-semibold tracking-tight text-white mb-4">Got your SIM sorted?</h2>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/sanxingdui-museum-booking" class="inline-flex items-center justify-center px-8 py-3.5 btn btn-primary">Book Sanxingdui Tickets</a>
        <a href="/china-240-hour-transit-visa" class="inline-flex items-center justify-center px-8 py-3.5 btn btn-ghost-light">Visa Guide</a>
      </div>
    </div>
  </section>
</BaseLayout>
