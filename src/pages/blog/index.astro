---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Ancient China Travel Blog";
const description = "In-depth articles on Chinese archaeology, ancient site guides, museum booking tips, and latest discoveries.";

const posts = [
  { slug: "chinese-neolithic-jade-guide", title: "A Foreigner's Guide to Neolithic Chinese Jade: Cong, Bi, and What They Mean", date: "2026-08-04", excerpt: "How to understand the jade objects you will see at Liangzhu, Sanxingdui, and every Chinese museum. What cong and bi disks actually represented, and why they are the key to understanding early Chinese civilization." },
  { slug: "liangzhu-vs-sanxingdui", title: "Liangzhu vs Sanxingdui: Which Ancient Site Should You Visit First?", date: "2026-08-03", excerpt: "Both are extraordinary. Both are Neolithic. But they could not be more different. A practical comparison to help you decide which fits your trip." },
];

const schemaJson = JSON.stringify([
  {
  "@type": "Blog",
  "name": "Ancient China Travel Blog",
  "description": description,
  "url": "https://5000-year-old-chinese-tomb.com/blog",
  "author": { "@type": "Person", "name": "Alex Chen", "url": "https://5000-year-old-chinese-tomb.com/about" },
  "blogPost": posts.map((p, i) => ({
    "@type": "BlogPosting",
    "headline": p.title,
    "url": "https://5000-year-old-chinese-tomb.com/blog/" + p.slug,
    "datePublished": p.date,
    "description": p.excerpt,
    "position": i + 1,
  })),
}]);
---

<BaseLayout {title} {description} {schemaJson}>
  <section class="bg-warm-900 py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <p class="text-sm font-medium tracking-wide text-accent/80 mb-4">Blog</p>
      <h1 class="text-3xl md:text-5xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">Ancient China Travel Blog</h1>
      <p class="mt-4 text-lg text-warm-200/80 max-w-2xl">In-depth articles on Chinese archaeology, practical travel tips, and the latest excavation news.</p>
    </div>
  </section>

  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <div class="space-y-8">
      {posts.map((post) => (
        <article class="group border-b border-border pb-8">
          <a href={`/blog/${post.slug}`}>
            <p class="text-xs text-muted mb-2">{post.date} &middot; by <span class="text-accent">Alex Chen</span></p>
            <h2 class="text-xl font-display font-semibold tracking-tight mb-2 group-hover:text-accent transition-colors">{post.title}</h2>
            <p class="text-sm text-warm-700 leading-relaxed">{post.excerpt}</p>
          </a>
        </article>
      ))}
    </div>
    <div class="mt-12 pt-8 border-t border-border/50 text-center text-sm text-muted">
      <p>More articles coming soon. <a href="/" class="text-accent hover:underline">Browse all sites &rarr;</a></p>
    </div>
  </section>

  <section class="bg-warm-900 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <h2 class="text-xl font-display font-semibold tracking-tight text-white mb-4">Planning your trip?</h2>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/" class="inline-flex items-center justify-center px-8 py-3.5 btn btn-primary">Browse All Sites</a>
        <a href="/ancient-china-10-day-itinerary" class="inline-flex items-center justify-center px-8 py-3.5 btn btn-ghost-light">10-Day Itinerary</a>
      </div>
    </div>
  </section>
</BaseLayout>


