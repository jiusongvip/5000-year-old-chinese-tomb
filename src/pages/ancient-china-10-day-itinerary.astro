---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Plane, TrainFront } from '@lucide/astro';

const title = "Ancient China in 10 Days: The Ultimate Archaeological Itinerary";
const description = "10-day ancient China itinerary covering Liangzhu, Sanxingdui, Terracotta Warriors, Yin Xu. Day-by-day plan with transport, tickets, hotels, and insider tips for first-time visitors.";

const schemaJson = JSON.stringify([
  {
    "@type": "TravelGuide",
    "name": "Ancient China in 10 Days: Walk Through 5,000 Years",
    "description": "A 10-day itinerary for foreign travelers covering the most significant ancient Chinese archaeological sites, including Liangzhu, Sanxingdui, Terracotta Warriors, and Yin Xu.",
    "dateModified": "2026-08-04",
    "itinerary": {
      "@type": "Itinerary",
      "numberOfDays": 10,
      "itineraryLocation": [
        { "@type": "City", "name": "Hangzhou" },
        { "@type": "City", "name": "Chengdu" },
        { "@type": "City", "name": "Xi'an" },
        { "@type": "City", "name": "Anyang" }
      ]
    }
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Is 10 days enough for an ancient China tour?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, 10 days is the minimum to cover four major sites (Liangzhu, Sanxingdui, Terracotta Warriors, Yin Xu) at a comfortable pace. If you have more time, consider adding 2–3 days for Beijing or Luoyang." } },
      { "@type": "Question", "name": "What is the best time of year for this itinerary?", "acceptedAnswer": { "@type": "Answer", "text": "April–May and September–October offer the best combination of mild weather and manageable crowds. Avoid Chinese National Day (October 1–7) and the summer months of July–August when temperatures in Xi’an can exceed 38°C." } },
      { "@type": "Question", "name": "How much does this 10-day itinerary cost?", "acceptedAnswer": { "@type": "Answer", "text": "Budget approximately CNY 8,000–12,000 (USD 1,100–1,700) per person excluding international flights. This covers high-speed trains, mid-range hotels, site tickets, food, and local transport. Luxury travellers should budget CNY 15,000–25,000." } },
      { "@type": "Question", "name": "Do I need a visa for this itinerary?", "acceptedAnswer": { "@type": "Answer", "text": "Many nationalities can use China's 240-hour (10-day) transit visa-free policy, which covers Hangzhou, Chengdu, Xi'an, and Zhengzhou (near Anyang). Check whether your passport qualifies and plan entry/exit accordingly. See our visa guide for details." } },
    ]
  }
]);
---

<BaseLayout {title} {description} schemaJson={schemaJson} author="Alex Chen" datePublished="2026-08-04" dateModified="2026-08-04" ogType="article">

  <!-- Hero -->
  <section class="relative overflow-hidden bg-warm-900 py-20">
    <img
      src="/og-itinerary.webp"
      alt="Ancient China 10-day itinerary covering Liangzhu, Sanxingdui, the Terracotta Warriors and Yin Xu"
      class="absolute inset-0 h-full w-full object-cover opacity-25"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-warm-900/60 via-warm-900/40 to-warm-900/85" aria-hidden="true"></div>
    <div class="relative max-w-[1200px] mx-auto px-6">
      <p class="text-sm font-medium tracking-wide text-accent/80 mb-4">Itinerary &middot; 4 Cities &middot; 4 UNESCO Sites</p>
      <h1 class="text-3xl md:text-5xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">Ancient China in 10 Days: Walk Through 5,000 Years</h1>
      <p class="mt-4 text-lg text-warm-200/80 max-w-2xl leading-relaxed">From Neolithic jade at Liangzhu to Shang Dynasty oracle bones at Yin Xu. Four cities, four UNESCO sites, one incredible journey through the birth of Chinese civilization.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">Liangzhu 5,300 yr</span>
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">Sanxingdui 4,800 yr</span>
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">Terracotta Warriors 2,200 yr</span>
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">Yin Xu 3,300 yr</span>
      </div>
      <div class="mt-8 grid grid-cols-4 gap-6 max-w-lg">
        <div><p class="text-2xl font-bold text-white">10</p><p class="text-xs text-warm-200/70">Days</p></div>
        <div><p class="text-2xl font-bold text-white">4</p><p class="text-xs text-warm-200/70">Cities</p></div>
        <div><p class="text-2xl font-bold text-white">3</p><p class="text-xs text-warm-200/70">UNESCO Sites</p></div>
        <div><p class="text-2xl font-bold text-white">8-12k</p><p class="text-xs text-warm-200/70">CNY Budget</p></div>
      </div>
    </div>
  </section>

  <!-- Route Overview -->
  <section class="max-w-[1200px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-2 text-center">The Route at a Glance</h2>
    <p class="text-muted text-center text-sm mb-10 max-w-xl mx-auto">Four sites, five cities, all connected by high-speed rail — and it fits inside China's 240-hour visa-free window.</p>
    <div class="overflow-x-auto pb-4">
      <div class="flex items-center justify-between gap-1 md:gap-4 min-w-[760px] mx-auto">
        {
          [
            { city: 'Hangzhou', sub: 'Days 1–2 · Liangzhu', icon: 'plane' },
            { leg: 'Train ~10h' },
            { city: 'Chengdu', sub: 'Days 3–4 · Sanxingdui', icon: 'train' },
            { leg: 'Train ~3.5h' },
            { city: 'Xi\u2019an', sub: 'Days 5–7 · Warriors, Qianling', icon: 'train' },
            { leg: 'Train ~2.5h' },
            { city: 'Anyang', sub: 'Days 8–9 · Yin Xu', icon: 'train' },
            { leg: 'Train ~2.5h' },
            { city: 'Beijing', sub: 'Day 10 · Fly home', icon: 'plane' },
          ].map((step) => {
            if (step.leg) {
              return (
                <div class="flex flex-1 items-center gap-2 md:gap-3 self-center" aria-hidden="true">
                  <span class="h-px flex-1 bg-warm-300 border-t border-dashed border-warm-300"></span>
                  <span class="text-xs font-semibold text-accent whitespace-nowrap">{step.leg}</span>
                  <TrainFront class="w-4 h-4 text-muted shrink-0" />
                  <span class="h-px flex-1 bg-warm-300 border-t border-dashed border-warm-300"></span>
                </div>
              );
            }
            return (
              <div class="flex flex-col items-center text-center shrink-0 w-36">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/10 text-accent ring-1 ring-warm-200">
                  {step.icon === 'plane'
                    ? <Plane class="w-6 h-6" />
                    : <TrainFront class="w-6 h-6" />}
                </div>
                <p class="mt-2 font-display font-semibold text-warm-900">{step.city}</p>
                <p class="text-xs text-muted mt-0.5 whitespace-nowrap">{step.sub}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Why This Itinerary -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-4">Why This Itinerary Works</h2>
    <div class="space-y-4 text-warm-700 leading-relaxed">
      <p>Most ancient China tours focus on Beijing and the Great Wall. This itinerary takes you to the actual archaeological sites where Chinese civilization was born. You will walk through Neolithic cities older than the pyramids, stand in front of bronze masks that rewrote history, and see the Terracotta Warriors before the tour buses arrive.</p>
      <p>This route was designed for foreign travelers. Transit times are realistic. Hotels are near train stations. Every ticket booking step accounts for a foreign passport. You do not need to speak Chinese — though a translation app will help.</p>
      <p><strong>This itinerary works as a visa-free transit trip</strong> if your passport qualifies for China’s 240-hour policy. Fly into Hangzhou, exit via Beijing, and all four cities are covered.</p>
    </div>
  </section>

  <!-- Day-by-Day -->
  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-8">Day-by-Day Plan</h2>
      <div class="space-y-6">

        <!-- Day 1-2 -->
        <div class="card overflow-hidden group">
          <div class="md:flex md:items-stretch">
            <div class="relative md:w-60 lg:w-72 shrink-0 overflow-hidden">
              <img
                src="/liangzhu-card.webp"
                alt="Liangzhu Ancient City archaeological park with reconstructed earthen walls"
                class="h-44 md:h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute left-3 top-3 text-xs font-bold px-2.5 py-1 bg-accent text-white rounded-full">Day 1-2</span>
            </div>
            <div class="p-6 flex-1">
              <h3 class="font-display font-semibold mb-3">Hangzhou — Liangzhu Ancient City</h3>
              <p class="text-sm text-warm-700 leading-relaxed mb-2"><strong>Day 1:</strong> Fly into Hangzhou Xiaoshan International Airport. Check into a hotel near Hangzhou East Railway Station (convenient for Day 3 departure). If arriving early, walk around West Lake in the evening.</p>
              <p class="text-sm text-warm-700 leading-relaxed mb-2"><strong>Day 2:</strong> Metro Line 2 to Liangzhu Station (40 min), then 10-minute taxi to the park. Spend 3–4 hours exploring the archaeological park and museum. Return to Hangzhou by 4:00 PM. Evening: explore Hefang Street for dinner and souvenirs.</p>
              <p class="text-xs text-muted mt-3">Hotel suggestion: Mid-range near Hangzhou East Station (¥300–500/night). Luxury: Amanfayun near West Lake.</p>
            </div>
          </div>
        </div>

        <!-- Day 3-4 -->
        <div class="card overflow-hidden group">
          <div class="md:flex md:items-stretch">
            <div class="relative md:w-60 lg:w-72 shrink-0 overflow-hidden">
              <img
                src="/sanxingdui-card.webp"
                alt="Sanxingdui bronze masks and gold artifacts in the museum gallery"
                class="h-44 md:h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute left-3 top-3 text-xs font-bold px-2.5 py-1 bg-accent text-white rounded-full">Day 3-4</span>
            </div>
            <div class="p-6 flex-1">
              <h3 class="font-display font-semibold mb-3">Chengdu — Sanxingdui Museum</h3>
              <p class="text-sm text-warm-700 leading-relaxed mb-2"><strong>Day 3:</strong> Morning high-speed train Hangzhou East to Chengdu East (approximately 10 hours, ¥900 second class). This is the longest transit day. Alternatively, fly (2.5 hours, ¥600–1,200). Arrive evening, check in near Chengdu East Station or Chunxi Road.</p>
              <p class="text-sm text-warm-700 leading-relaxed mb-2"><strong>Day 4:</strong> Intercity train from Chengdu East to Guanghan North (20 min, ¥20), then taxi to Sanxingdui Museum. Spend 3–4 hours with the bronze masks and gold scepters. <strong>Book Sanxingdui tickets 7 days in advance on WeChat.</strong> Evening: Sichuan hot pot in Chengdu.</p>
              <p class="text-xs text-muted mt-3">Hotel suggestion: Near Chengdu East Station (¥200–400/night) for easy train access. Near Chunxi Road for nightlife and dining.</p>
            </div>
          </div>
        </div>

        <!-- Day 5-6 -->
        <div class="card overflow-hidden group">
          <div class="md:flex md:items-stretch">
            <div class="relative md:w-60 lg:w-72 shrink-0 overflow-hidden">
              <img
                src="/terracotta-card.webp"
                alt="Rows of Terracotta Warriors standing in excavation Pit 1"
                class="h-44 md:h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute left-3 top-3 text-xs font-bold px-2.5 py-1 bg-accent text-white rounded-full">Day 5-6</span>
            </div>
            <div class="p-6 flex-1">
              <h3 class="font-display font-semibold mb-3">Xi’an — Han Yangling & Terracotta Warriors</h3>
              <p class="text-sm text-warm-700 leading-relaxed mb-2"><strong>Day 5:</strong> Morning high-speed train Chengdu East to Xi’an North (3–4 hours, ¥260 second class). Check in near Xi’an Railway Station or Bell Tower. Afternoon: visit Han Yangling Mausoleum — the underground museum with glass floors above Han Dynasty burial pits. Far fewer crowds than the Warriors.</p>
              <p class="text-sm text-warm-700 leading-relaxed mb-2"><strong>Day 6:</strong> Terracotta Warriors. Take bus 306 from Xi’an Railway Station east square at 7:00 AM to arrive by 8:15 AM — essential for beating the crowds. Hire an English guide (¥200–300). Return by 2:00 PM. Evening: cycle the Xi’an City Wall.</p>
              <p class="text-xs text-muted mt-3">Hotel suggestion: Inside the city walls near Bell Tower (¥400–600/night). Budget hostels from ¥80 near the South Gate.</p>
            </div>
          </div>
        </div>

        <!-- Day 7 -->
        <div class="card overflow-hidden group">
          <div class="md:flex md:items-stretch">
            <div class="relative md:w-60 lg:w-72 shrink-0 overflow-hidden">
              <img
                src="/qianling-card.webp"
                alt="Qianling Mausoleum Spirit Way lined with stone guardian statues"
                class="h-44 md:h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute left-3 top-3 text-xs font-bold px-2.5 py-1 bg-accent text-white rounded-full">Day 7</span>
            </div>
            <div class="p-6 flex-1">
              <h3 class="font-display font-semibold mb-3">Xi’an — Qianling Mausoleum</h3>
              <p class="text-sm text-warm-700 leading-relaxed mb-2">Day trip to Qianling Mausoleum, the joint tomb of Emperor Gaozong and China’s only female emperor, Wu Zetian. Located 85 km northwest of Xi’an. Hire a car with driver (approximately ¥500 for the day). Walk the Spirit Way lined with stone guardians. Visit the accompanying museum for Tang Dynasty murals and artifacts. Evening: Muslim Quarter for street food.</p>
              <p class="text-xs text-muted mt-3">Stay same hotel as Days 5–6. Pack water and snacks — limited dining near Qianling.</p>
            </div>
          </div>
        </div>

        <!-- Day 8-9 -->
        <div class="card overflow-hidden group">
          <div class="md:flex md:items-stretch">
            <div class="relative md:w-60 lg:w-72 shrink-0 overflow-hidden">
              <img
                src="/yinxu-card.webp"
                alt="Yin Xu archaeological site, the capital of the Shang Dynasty"
                class="h-44 md:h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute left-3 top-3 text-xs font-bold px-2.5 py-1 bg-accent text-white rounded-full">Day 8-9</span>
            </div>
            <div class="p-6 flex-1">
              <h3 class="font-display font-semibold mb-3">Anyang — Yin Xu</h3>
              <p class="text-sm text-warm-700 leading-relaxed mb-2"><strong>Day 8:</strong> Morning high-speed train Xi’an North to Anyang East (2.5 hours, ¥200 second class). Check in. Afternoon: visit the National Museum of Chinese Writing (Zhongguo Wenzi Bowuguan). Excellent context for understanding oracle bones before you see them at Yin Xu the next day.</p>
              <p class="text-sm text-warm-700 leading-relaxed mb-2"><strong>Day 9:</strong> Full morning at Yin Xu. Start at the new museum (opened 2024), then walk the palace-temple area and the Tomb of Fu Hao. Allocate 3–4 hours. Afternoon free or return to the museum to revisit favorite galleries.</p>
              <p class="text-xs text-muted mt-3">Hotel suggestion: Near Anyang East Station (¥200–300/night). Limited international hotel options; a mid-range Chinese chain is your best bet.</p>
            </div>
          </div>
        </div>

        <!-- Day 10 -->
        <div class="card overflow-hidden border-accent/30 bg-gradient-to-br from-warm-50 to-paper-100 group">
          <div class="p-6">
            <div class="flex items-center gap-3 mb-3"><span class="text-xs font-bold px-3 py-1 bg-warm-900 text-white rounded-full">Day 10</span><h3 class="font-display font-semibold">Anyang to Beijing — Departure</h3></div>
            <p class="text-sm text-warm-700 leading-relaxed mb-2">Morning high-speed train Anyang East to Beijing West (2.5 hours, ¥200–250). If your flight departs in the evening, store luggage at Beijing West Station and visit the National Museum of China (free, but book 1–3 days ahead on WeChat) or Tiananmen Square. Fly out from Beijing Capital or Beijing Daxing International Airport.</p>
            <p class="text-xs text-muted mt-3">If using the 240-hour transit visa, Beijing (PEK/PKX) works as your exit port. Ensure your departure flight is within the 240-hour window.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Budget Breakdown -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Budget Breakdown (CNY)</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="border-b border-border"><th class="text-left py-2 font-medium">Item</th><th class="text-right py-2 font-medium">Cost</th></tr></thead>
        <tbody class="divide-y divide-border/50">
          <tr><td class="py-2">High-speed trains, 4 legs</td><td class="text-right py-2">~2,500</td></tr>
          <tr><td class="py-2">Site tickets, 4 sites</td><td class="text-right py-2">~350</td></tr>
          <tr><td class="py-2">Hotels, 9 nights mid-range</td><td class="text-right py-2">~3,600</td></tr>
          <tr><td class="py-2">Food, 10 days</td><td class="text-right py-2">~2,000</td></tr>
          <tr><td class="py-2">Local transport, guides, tips</td><td class="text-right py-2">~1,500</td></tr>
          <tr class="font-semibold"><td class="py-2">Total, excluding international flights</td><td class="text-right py-2">~9,950</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-muted mt-4">Prices verified August 2026. Budget CNY 8,000–18,000 depending on travel style. Luxury travelers: add approximately CNY 8,000–10,000 for 5-star hotels and private drivers.</p>
  </section>

  <!-- Practical Tips -->
  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Practical Tips for This Itinerary</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card p-5">
          <h3 class="font-semibold mb-2">Before You Go</h3>
          <ul class="space-y-2 text-sm text-warm-700">
            <li>• Install WeChat and Alipay, link a credit card for payments</li>
            <li>• Book all train tickets on Trip.com or 12306.cn (requires account)</li>
            <li>• Check your visa eligibility: this route fits the 240-hour transit policy</li>
            <li>• Download an offline translation app and save Chinese names of all sites</li>
          </ul>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold mb-2">On the Road</h3>
          <ul class="space-y-2 text-sm text-warm-700">
            <li>• Carry your passport at all times — required for hotels and train stations</li>
            <li>• Book Sanxingdui tickets 7 days in advance at 8:00 PM Beijing time</li>
            <li>• Arrive at train stations 30–45 minutes early for security screening</li>
            <li>• Avoid the October Golden Week when all sites are extremely crowded</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  

  <!-- Food & Dining Guide -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">What to Eat in Each City</h2>
    <div class="space-y-4 text-sm text-warm-700 leading-relaxed">
      <div class="card p-5">
        <h3 class="font-semibold mb-2">Hangzhou (Days 1–2)</h3>
        <p><strong>Must try:</strong> Dongpo pork (braised pork belly), Longjing shrimp (stir-fried with tea leaves), West Lake vinegar fish. <strong>Where:</strong> Louwailou restaurant near West Lake is the historic choice; Grandma's Kitchen (Waipojia) is the affordable local chain. <strong>Budget:</strong> ¥40–80 per meal mid-range.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-semibold mb-2">Chengdu (Days 3–4)</h3>
        <p><strong>Must try:</strong> Sichuan hot pot (Yuanji or Shu Daxia), dan dan noodles, mapo tofu. <strong>Where:</strong> Yulin neighborhood for local hot pot; Jinli Ancient Street for snacking. <strong>Warning:</strong> "Wei la" (mild spicy) is spicier than you think. Say "bu yao la" (no spice) if you cannot handle heat. <strong>Budget:</strong> ¥30–60 per meal.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-semibold mb-2">Xi'an (Days 5–7)</h3>
        <p><strong>Must try:</strong> Yangrou paomo (crumbled flatbread in lamb soup), biangbiang noodles, roujiamo (Chinese burger). <strong>Where:</strong> Muslim Quarter for street food, De Fa Chang for dumpling banquets. <strong>Budget:</strong> ¥20–50 per meal.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-semibold mb-2">Anyang (Days 8–10)</h3>
        <p><strong>Must try:</strong> Henan stewed noodles (huimian), Anyang sanbuli (steamed buns with various fillings). <strong>Where:</strong> Small restaurants near Anyang East Station are authentic and cheap. <strong>Budget:</strong> ¥15–30 per meal.</p>
      </div>
    </div>
  </section>

  <!-- What to Pack -->
  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">What to Pack</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-warm-700">
        <div class="card p-4"><h3 class="font-semibold mb-1">Essentials</h3><ul class="space-y-1"><li>• Passport (carry at all times)</li><li>• Phone with WeChat and Alipay (linked to credit card)</li><li>• VPN installed before departure</li><li>• Portable battery pack (10,000+ mAh)</li><li>• Printed hotel addresses in Chinese</li></ul></div>
        <div class="card p-4"><h3 class="font-semibold mb-1">Comfort</h3><ul class="space-y-1"><li>• Comfortable walking shoes (Xi'an City Wall + site walking = 20,000+ steps/day)</li><li>• Sunscreen and hat (limited shade at sites)</li><li>• Toilet paper (public toilets often lack it)</li><li>• Hand sanitizer</li></ul></div>
        <div class="card p-4"><h3 class="font-semibold mb-1">Tech</h3><ul class="space-y-1"><li>• Offline translation app with Chinese pack downloaded</li><li>• Offline map (Apple Maps or Amap with offline data)</li><li>• Universal power adapter (China uses Type A/C/I sockets)</li></ul></div>
        <div class="card p-4"><h3 class="font-semibold mb-1">Seasonal</h3><ul class="space-y-1"><li>• April/October: light jacket for evenings</li><li>• July/August: umbrella (rain + sun), insect repellent</li><li>• December/January: thermal layers (temperatures can drop below freezing in Anyang and Xi'an)</li></ul></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-warm-900 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <h2 class="text-xl font-display font-semibold tracking-tight text-white mb-4">Ready to walk through 5,000 years?</h2>
      <p class="text-warm-200 max-w-lg mx-auto mb-8">Each site on this itinerary has a detailed guide with ticket info, transport directions, and honest reviews. Start planning.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/" class="inline-flex items-center justify-center px-8 py-3.5 btn btn-primary">Browse All Sites</a>
        <a href="/china-240-hour-transit-visa" class="inline-flex items-center justify-center px-8 py-3.5 btn btn-ghost-light">Check Visa Guide</a>
      </div>
    </div>
  </section>
</BaseLayout>
