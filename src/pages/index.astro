<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  (function() {
    var L = window.L;
    var map = document.getElementById('site-map');
    if (!map) return;
    function init() {
      if (typeof L === 'undefined') { setTimeout(init, 100); return; }
      var m = L.map(map, { scrollWheelZoom: false, zoomControl: true }).setView([34.0, 111.0], 5);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 18
      }).addTo(m);
      var sites = [
        {name:'Dawenkou Site', lat:35.9, lng:117.1},
        {name:'Liangzhu Ancient City', lat:30.39, lng:120.0},
        {name:'Sanxingdui', lat:30.99, lng:104.19},
        {name:'Yin Xu', lat:36.13, lng:114.31},
        {name:'Terracotta Warriors', lat:34.38, lng:109.27},
        {name:'Han Yangling Mausoleum', lat:34.44, lng:108.94},
        {name:'Mawangdui Han Tombs', lat:28.2, lng:112.97},
        {name:'Qianling Mausoleum', lat:34.57, lng:108.22}
      ];
      var icon = L.divIcon({className:'site-marker', html:'<div style=\'background:#c2410c;color:#fff;width:10px;height:10px;border-radius:50%;border:2px solid #fff;box-shadow:0 1px 3px rgba(0,0,0,.3)\'></div>', iconSize:[14,14], iconAnchor:[7,7]});
      sites.forEach(function(s) {
        L.marker([s.lat, s.lng], {icon:icon}).addTo(m).bindTooltip(s.name, {permanent:false, direction:'top', offset:[0,-8], className:'site-tooltip'});
      });
    }
    init();
  })();
</script>

