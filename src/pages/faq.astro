---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTACard from '../components/CTACard.astro';
import { Plus } from '@lucide/astro';
import { faqSchema } from '../data/schemas';

const title = 'FAQ: Visiting Ancient Chinese Archaeological Sites';
const description = 'Answers to the most common questions about visiting ancient Chinese archaeological sites — booking tickets with a passport, visa-free travel, crowds, and what to expect at each site.';

const faqs = [
  { q: 'Can foreigners visit ancient Chinese archaeological sites?', a: 'Yes. All eight sites on this site are open to foreign visitors. Most require a passport for entry, and the museum-based sites (Sanxingdui, Shaanxi History Museum, Henan Museum) require advance booking through WeChat mini-programs.' },
  { q: 'Do I need a visa to visit ancient China sites?', a: 'Many nationalities can visit visa-free for up to 240 hours (10 days) under China\'s transit visa-free policy, which covers all the cities on our itineraries. For longer trips, apply for a tourist visa (L visa) at your nearest Chinese embassy or consulate.' },
  { q: 'How do I book museum tickets with a foreign passport?', a: 'Use the museum\'s WeChat mini-program. Select "Passport" (护照) as your ID type and enter your passport number exactly as it appears. Some museums (Sanxingdui, Shaanxi History Museum) release tickets 7 days in advance and sell out fast — book as soon as the window opens.' },
  { q: 'Do I need to speak Chinese?', a: 'No. The major museums and sites have English signage, and most ticket kiosks accept passports. A translation app with the Chinese names of sites saved offline will make transport and booking much easier.' },
  { q: 'Which ancient China sites are free to visit?', a: 'The Dawenkou Site in Shandong is open free of charge (its museum is also free). The Mawangdui relics at the Hunan Museum in Changsha are free, though you must reserve a timed entry slot. All other sites on this list charge entry.' },
  { q: 'What is the best time of year to visit ancient Chinese sites?', a: 'April–May and September–October offer the best weather and manageable crowds. Avoid Chinese public holidays — especially National Day (Oct 1–7), May Day, and Spring Festival — when tickets sell out and queues stretch for hours.' },
  { q: 'Can I take photos inside the sites and museums?', a: 'Photography without flash is generally allowed at all eight sites. Flash, tripods, and selfie sticks are prohibited. Some temporary exhibitions at Sanxingdui and the Shaanxi History Museum may have additional restrictions.' },
  { q: 'How long should I spend at each site?', a: 'Plan 2–3 hours for smaller sites (Han Yangling, Mawangdui, Dawenkou) and 3–4 hours for the major ones (Liangzhu, Sanxingdui, Yin Xu, Terracotta Warriors, Qianling). The Terracotta Warriors and Qianling also need travel time from Xi\'an.' },
  { q: 'Are the sites wheelchair accessible?', a: 'Most of the museum buildings are fully accessible. The archaeological parks (Liangzhu, Yin Xu, Qianling) are large open areas with paved paths and available electric shuttle carts — check with the ticket office on arrival.' },
  { q: 'How much should I budget for tickets?', a: 'Site tickets range from free (Dawenkou, Mawangdui) to ¥120 (Terracotta Warriors). Budget roughly ¥350–500 for tickets across a 10-day itinerary, plus ¥30–60 per day for local transport and food.' },
];

const schemaJson = JSON.stringify(faqSchema(faqs));

const relatedLinks = [
  { href: '/china-museum-booking-guide', label: 'how to book chinese museum tickets with passport' },
  { href: '/china-240-hour-transit-visa', label: 'china 240 hour transit visa' },
  { href: '/best-time-to-visit-china', label: 'best time to visit china for ancient sites' },
  { href: '/terracotta-warriors', label: 'terracotta warriors tickets and hours' },
  { href: '/dawenkou-site', label: 'free ancient archaeological sites in china' },
];
---

<BaseLayout {title} {description} schemaJson={schemaJson}>
  <section class="bg-warm-900 py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeader eyebrow="FAQ" title={title} subtitle="The questions travelers actually ask — answered with firsthand, passport-tested information." dark />
    </div>
  </section>

  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <div class="space-y-4">
      {faqs.map((f, i) => (
        <details class="group card overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer list-none font-display font-semibold text-warm-900 hover:bg-warm-50 transition-colors">
            <span>{i + 1}. {f.q}</span>
            <span class="flex-shrink-0 text-accent transition-transform duration-200 group-open:rotate-45">
              <Plus class="w-4 h-4" />
            </span>
          </summary>
          <p class="px-6 pb-5 text-sm text-warm-700 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>

    <div class="mt-12 p-6 bg-warm-50 rounded-lg border border-border text-sm text-warm-700">
      <p><strong>Still have a question?</strong> Every site guide on this site has a dedicated FAQ, and the booking guides walk through each museum step by step. If you get stuck on the road, email us at <a href="mailto:hello@5000-year-old-chinese-tomb.com" class="text-accent hover:underline">hello@5000-year-old-chinese-tomb.com</a>.</p>
    </div>
  </section>

  <CTACard title="Plan your ancient China trip" subtitle="Browse all eight sites or start with a ready-made itinerary." primaryHref="/" primaryLabel="Browse All Sites" secondaryHref="/ancient-china-10-day-itinerary" secondaryLabel="10-Day Itinerary" />

  <RelatedLinks links={relatedLinks} />
</BaseLayout>