---
import BaseLayout from "../layouts/BaseLayout.astro";
import { highlightedSites } from "../data/sites";

const title = "5,000-Year-Old Royal Tomb Discovered in China";
const description =
  "A 5,000-year-old royal tomb was just discovered at the Wangzhuang site in Henan, China. Here\u0027s what archaeologists found inside M27, why the Dawenkou culture matters, and 5 equally ancient sites you CAN visit right now.";

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is the 5,000-year-old Chinese tomb?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It is the Wangzhuang M27 tomb, discovered in Yongcheng, Henan Province, China. Measuring 4.8 by 3.68 meters, it belongs to the late Dawenkou Culture (approx. 3,000 BCE) and contained over 350 burial objects, including nearly 200 jade artifacts. Archaeologists believe the Wangzhuang site may have been the capital of a prehistoric kingdom called Huaiyi.",
      },
    },
    {
      "@type": "Question",
      name: "Where is the Wangzhuang site?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The Wangzhuang site is located in Yongcheng, a county-level city in eastern Henan Province, China. It is roughly 300 km east of Zhengzhou, the provincial capital.",
      },
    },
    {
      "@type": "Question",
      name: "Can I visit the 5,000-year-old tomb?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No, the Wangzhuang M27 tomb is an active archaeological excavation site and is not open to the public. Excavation work may continue for years, and it is unknown when or if the site will open to visitors.",
      },
    },
    {
      "@type": "Question",
      name: "What other ancient tombs can I visit in China?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Several equally ancient Chinese archaeological sites are open to visitors: Liangzhu Ancient City (5,300 years old, UNESCO), Sanxingdui (4,800 years old), Yin Xu (3,300 years old, UNESCO), the Dawenkou Site Museum (6,300 years old), and the Han Yangling Mausoleum (2,100 years old).",
      },
    },
    {
      "@type": "Question",
      name: "How old is Chinese civilization?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The Liangzhu culture (c. 3300-2300 BCE) provides the earliest archaeological evidence of a complex state-level society in China, recognized as a UNESCO World Heritage Site in 2019. The Dawenkou culture predates Liangzhu, extending Chinese civilization\u0027s roots to at least 6,300 years ago.",
      },
    },
  ],
};

const schemaJson = JSON.stringify([
  {
    "@type": "Article",
    headline: title,
    description,
    datePublished: "2025-03-15",
    dateModified: "2026-08-04",
    author: { "@type": "Person", "name": "Alex Chen", "url": "https://5000-year-old-chinese-tomb.com/about" },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://5000-year-old-chinese-tomb.com",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "5,000-Year-Old Chinese Tomb",
        item: "https://5000-year-old-chinese-tomb.com/5000-year-old-chinese-tomb",
      },
    ],
  },
  faqSchema,
]);
---

<BaseLayout
  {title}
  {description}
  schemaJson={schemaJson}
  lastUpdated="August 4, 2026"
>
  <slot name="head">
    <meta
      property="og:image"
      content="https://5000-year-old-chinese-tomb.com/og-tomb.webp"
    />
  </slot>

  <!-- Hero -->
  <section
    class="relative min-h-[60dvh] flex items-center overflow-hidden bg-warm-900"
  >
    <div class="absolute inset-0 z-0 opacity-30">
      <img
        src="/og-tomb.webp"
        alt="Ancient Neolithic Chinese tomb excavation with jade artifacts"
        class="w-full h-full object-cover"
        loading="eager"
      />
    </div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-20">
      <p class="text-sm font-medium tracking-wide text-accent/80 mb-4">
        Latest Discovery
      </p>
      <h1
        class="text-3xl md:text-5xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl"
      >
        The 5,000-Year-Old Chinese Tomb Everyone\u0027s Talking About
      </h1>
      <p
        class="mt-6 text-lg text-warm-200/80 max-w-2xl leading-relaxed"
      >
        A Neolithic tomb with 350 burial objects and nearly 200 jade artifacts
        was just uncovered in Henan. Here\u0027s what archaeologists found, why the
        find rewrites Chinese prehistory, and where you can see something just
        as ancient yourself.
      </p>
    </div>
  </section>

  <!-- What Was Discovered -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">
      What Was Discovered
    </h2>

    <div class="space-y-5 text-warm-700 leading-relaxed">
      <p>
        In early 2025, Chinese archaeologists announced a discovery that
        reshapes our understanding of prehistoric China: a monumental tomb at
        the <strong>Wangzhuang site</strong> in Yongcheng, Henan Province.
        Designated <strong>M27</strong>, the tomb measures approximately 4.8
        meters long by 3.68 meters wide, covering more than 17 square
        meters\u2014making it one of the largest and most artifact-rich burials
        ever found from the <strong>Dawenkou Culture</strong>.
      </p>

      <h3 class="text-lg font-display font-semibold text-warm-900 pt-2">
        What Was Inside
      </h3>
      <p>
        The burial chamber yielded over 350 objects. Nearly
        <strong>200 jade artifacts</strong> were recovered\u2014ornaments,
        pendants, and ritual implements\u2014scattered both inside and outside
        the wooden coffin. Beyond jade, archaeologists catalogued pottery
        vessels, stone tools, bone implements, and animal remains including
        <strong>pig mandibles</strong>, a common marker of wealth and ritual
        status in Neolithic East Asia.
      </p>
      <p>
        The sheer density of grave goods sets M27 apart. Most Dawenkou Culture
        burials contain a few dozen items at most. A single tomb with 350
        artifacts signals an occupant of extraordinary status\u2014someone who
        commanded enough labor and resources to be buried with a treasury of
        prestige objects.
      </p>

      <h3 class="text-lg font-display font-semibold text-warm-900 pt-2">
        A Prehistoric Capital
      </h3>
      <p>
        M27 does not stand alone. Since excavations began in 2023, a joint
        archaeological team has uncovered
        <strong>45 Dawenkou Culture tombs</strong> across the Wangzhuang site.
        The density of elite burials, combined with the site\u0027s overall
        scale, has led researchers to propose that Wangzhuang was not a typical
        Neolithic village. Zhu Guanghua, the site director, told the South
        China Morning Post that Wangzhuang may have been the capital of a
        prehistoric kingdom he identifies as <strong>Huaiyi</strong>\u2014a
        political entity that flourished centuries before China\u0027s first
        historically-attested dynasty, the Xia.
      </p>
      <p>
        Li Xinwei, a professor at the Institute of Archaeology at the Chinese
        Academy of Social Sciences, described the site as an
        <strong>\u201Cimportant model\u201D</strong> for studying prehistoric
        social complexity across different regions of China. The tomb, he
        noted, \u201Chighlights the preliminary form of kingship in the
        prehistoric Central Plains region.\u201D
      </p>

      <h3 class="text-lg font-display font-semibold text-warm-900 pt-2">
        A Cultural Crossroads
      </h3>
      <p>
        One of the most striking findings is that the Wangzhuang artifacts show
        influences from
        <strong>four distinct Neolithic cultures</strong> that coexisted across
        what is now China:
      </p>
      <ul class="list-disc pl-5 space-y-1 text-sm">
        <li>
          <strong>Dawenkou</strong> (eastern China, 4300\u20132600
          BCE)\u2014the tomb\u0027s own cultural tradition
        </li>
        <li>
          <strong>Yangshao</strong> (Central Plains, 5000\u20133000
          BCE)\u2014painted pottery and millet-farming culture
        </li>
        <li>
          <strong>Qujialing</strong> (middle Yangtze, 3300\u20132600
          BCE)\u2014southern ceramic and jade traditions
        </li>
        <li>
          <strong>Liangzhu</strong> (lower Yangtze, 3300\u20132300
          BCE)\u2014the jade-working civilization now recognized as a
          UNESCO World Heritage Site
        </li>
      </ul>
      <p>
        \u201CThe ancient residents were clearly influenced by the cultures of
        the eastern region and the central region, as well as cultural elements
        from the Yangtze River basin,\u201D Li Xinwei explained. This suggests
        Wangzhuang sat at a
        <strong>prehistoric cultural intersection</strong>\u2014a place where
        ideas, technologies, and prestige goods flowed between distant
        Neolithic societies across a vast territory.
      </p>

      <h3 class="text-lg font-display font-semibold text-warm-900 pt-2">
        What Was Lost
      </h3>
      <p>
        The tomb had been <strong>previously looted</strong>, likely centuries
        ago. Many significant artifacts were removed before archaeologists
        arrived, and only a few skeletal remains survive\u2014including toe
        bones. The looting means we will never know the full richness of M27\u2019s
        original burial assemblage, but the fact that 350 objects remained even
        after centuries of disturbance underscores just how extraordinary this
        grave must have been.
      </p>
    </div>

    <div class="mt-10 p-6 bg-warm-50 rounded-lg border border-border">
      <h3 class="font-semibold text-lg mb-3">Key Facts</h3>
      <dl
        class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2 text-sm"
      >
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Site name</dt>
          <dd class="font-medium text-warm-900">Wangzhuang Site (王庄遗址)</dd>
        </div>
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Tomb designation</dt>
          <dd class="font-medium text-warm-900">M27</dd>
        </div>
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Tomb size</dt>
          <dd class="font-medium text-warm-900">4.8 m × 3.68 m (17+ sq m)</dd>
        </div>
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Location</dt>
          <dd class="font-medium text-warm-900">Yongcheng, Henan, China</dd>
        </div>
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Approximate date</dt>
          <dd class="font-medium text-warm-900">~3,000 BCE</dd>
        </div>
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Culture</dt>
          <dd class="font-medium text-warm-900">
            Dawenkou (late phase, 4300\u20132600 BCE)
          </dd>
        </div>
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Artifacts recovered</dt>
          <dd class="font-medium text-warm-900">
            350+ items, ~200 jades, pottery, bone tools, animal remains
          </dd>
        </div>
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Excavation period</dt>
          <dd class="font-medium text-warm-900">2023\u2013present (ongoing)</dd>
        </div>
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Total tombs at site</dt>
          <dd class="font-medium text-warm-900">45+ Dawenkou Culture tombs</dd>
        </div>
        <div class="flex justify-between py-1.5 border-b border-border/50">
          <dt class="text-muted">Proposed kingdom</dt>
          <dd class="font-medium text-warm-900">Huaiyi (per site director)</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Why It Matters -->
  <section class="bg-warm-50 border-y border-border reveal">
    <div class="max-w-[800px] mx-auto px-6 py-12">
      <h2
        class="text-2xl font-display font-semibold tracking-tight mb-4"
      >
        Why This Discovery Matters
      </h2>
      <div class="space-y-4 text-warm-700 leading-relaxed">
        <p>
          At roughly 3,000 BCE, the M27 burial predates the
          <strong>Egyptian pyramids</strong> by several centuries and pushes
          the timeline of complex political organization in China deeper into
          prehistory. The Dawenkou Culture, long considered a regional Neolithic
          society, now appears to have supported a level of social hierarchy
          that some archaeologists describe as
          <strong>proto-kingship</strong>.
        </p>
        <p>
          The four-culture intersection visible in the Wangzhuang artifacts also
          challenges an older narrative in Chinese archaeology\u2014that Chinese
          civilization radiated outward from a single Central Plains
          \u201Ccradle.\u201D Instead, Wangzhuang suggests that early Chinese
          state formation emerged from
          <strong>interaction between multiple sophisticated Neolithic
          cultures</strong> trading goods, ideas, and political models across
          hundreds of kilometers.
        </p>
        <p>
          As excavations continue, Wangzhuang may yield answers to one of the
          most debated questions in East Asian archaeology: when and how did
          kingship first emerge in what would become China? For now, M27 stands
          as the strongest evidence yet that the answer may lie further back
          than anyone expected.
        </p>
      </div>
    </div>
  </section>

  <!-- The Answer: Can You Visit? -->
  <section class="bg-accent/5 border-y border-accent/20 reveal">
    <div class="max-w-[800px] mx-auto px-6 py-12 text-center">
      <h2
        class="text-2xl font-display font-semibold tracking-tight mb-4"
      >
        Can You Visit the 5,000-Year-Old Tomb?
      </h2>
      <p class="text-3xl font-bold text-accent mb-4">No.</p>
      <p class="text-warm-700 leading-relaxed max-w-xl mx-auto">
        The Wangzhuang M27 tomb is an active archaeological excavation site.
        It is not open to the public, and digging may continue for years. There
        is no announced timeline for public access\u2014the site remains a
        working research dig, not a tourist destination.
      </p>
    </div>
  </section>

  <!-- The Bridge: Sites You CAN Visit -->
  <section class="max-w-[1200px] mx-auto px-6 py-20 reveal">
    <h2
      class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2"
    >
      5 Ancient Sites You <em>Can</em> Walk Into Right Now
    </h2>
    <p class="text-muted mb-10 max-w-2xl">
      The Wangzhuang tomb may be off limits, but China has remarkable ancient
      archaeological sites that are open to visitors. Each one below is as old
      or nearly as old, and every one welcomes foreign travelers.
    </p>

    <div class="space-y-10">
      {
        highlightedSites.map((site) => (
          <a
            href={`/${site.slug}`}
            class="group flex flex-col md:flex-row gap-6 p-6 bg-white rounded-lg border border-border hover:border-accent/30 hover:shadow-sm transition-all duration-200"
          >
            <div
              class="w-full md:w-48 aspect-[3/2] md:aspect-[4/3] flex-shrink-0 overflow-hidden rounded-md bg-warm-100"
            >
              <img
                src={site.image}
                alt={site.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="flex flex-col justify-center flex-1">
              <div class="flex items-center gap-3 mb-1">
                <h3 class="font-display font-semibold text-xl">
                  {site.name}
                </h3>
                {site.unesco && (
                  <span
                    class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-warm-100 text-warm-700"
                  >
                    UNESCO {site.unescoYear}
                  </span>
                )}
              </div>
              <p class="text-sm text-muted mb-2">
                {site.yearsAgo.toLocaleString()} years old &middot;{" "}
                {site.culture} &middot; {site.city}, {site.province}
              </p>
              <div
                class="flex flex-wrap items-center gap-x-6 gap-y-1 text-sm"
              >
                <span class="text-warm-700">
                  {site.ticketLow === 0
                    ? "Free entry"
                    : `¥${site.ticketLow} ticket`}
                </span>
                <span class="text-warm-700">{site.hours}</span>
                <span class="text-warm-700">{site.visitTime}</span>
              </div>
              <span
                class="inline-flex items-center mt-3 text-sm font-medium text-accent group-hover:underline"
              >
                See full guide
                <svg
                  class="ml-1 w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Secondary CTA -->
  <section class="bg-warm-900 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <h2
        class="text-xl md:text-2xl font-display font-semibold tracking-tight text-white mb-4"
      >
        Want more sites like this?
      </h2>
      <p class="text-warm-200 max-w-lg mx-auto mb-8">
        Browse all 8 ancient Chinese archaeological sites, plus ready-made
        itineraries and step-by-step museum booking guides.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-8 py-3.5 bg-accent text-white font-medium rounded-lg hover:bg-accent-dark active:scale-[0.98] transition-all duration-150"
        >
          Browse All Sites
        </a>
        <a
          href="/ancient-china-10-day-itinerary"
          class="inline-flex items-center justify-center px-8 py-3.5 border border-white/40 text-white font-medium rounded-lg hover:bg-white/10 active:scale-[0.98] transition-all duration-150"
        >
          View the 10-Day Itinerary
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
