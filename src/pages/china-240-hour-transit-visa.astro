---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "China 240-Hour Transit Visa: Complete Guide for Tourists (2026)";
const description = "Complete guide to China’s 240-hour (10-day) transit visa-free policy. Eligible nationalities, how it works, port requirements, and how to plan an ancient China itinerary entirely visa-free.";

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", "name": "What is the China 240-hour transit visa-free policy?", "acceptedAnswer": { "@type": "Answer", "text": "The 240-hour transit visa-free policy allows citizens of 54 eligible countries to enter China without a visa for up to 240 hours (10 days) when transiting through China to a third country. You must arrive at one of the designated entry ports and depart from one of the designated exit ports, with confirmed onward tickets." } },
    { "@type": "Question", "name": "Which nationalities are eligible for the 240-hour transit visa?", "acceptedAnswer": { "@type": "Answer", "text": "54 countries are eligible, including the United States, Canada, United Kingdom, Australia, New Zealand, most EU countries, Japan, South Korea, and Singapore. Check the official China National Immigration Administration website for the complete and most current list." } },
    { "@type": "Question", "name": "Can I visit multiple cities on the 240-hour transit visa?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The policy allows travel within designated regions. For example, you can enter through Hangzhou, travel to Chengdu and Xi'an, and exit through Beijing — all within the 240-hour window. You must stay within the permitted areas. The policy covers most major cities including those on our ancient China itinerary." } },
    { "@type": "Question", "name": "Do I need a confirmed hotel booking for the transit visa?", "acceptedAnswer": { "@type": "Answer", "text": "Hotel bookings are required at immigration. Have printed or digital copies of all hotel reservations for your entire stay. Immigration officers may ask to see them. Also carry your confirmed onward flight ticket out of China to a third country." } },
  ],
};

const schemaJson = JSON.stringify([
  { "@type": "Article", "headline": "China 240-Hour Transit Visa: Complete Guide for Tourists (2026)", "description": description, "dateModified": "2026-08-04" },
    {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://5000-year-old-chinese-tomb.com" },
      { "@type": "ListItem", "position": 2, "name": "China 240-Hour Transit Visa", "item": "https://5000-year-old-chinese-tomb.com/china-240-hour-transit-visa" }
    ]
  },
faqSchema,
]);
---

<BaseLayout {title} {description} schemaJson={schemaJson} lastUpdated="August 4, 2026">
  <slot name="head"><meta property="og:image" content="https://5000-year-old-chinese-tomb.com/og-visa.webp" /></slot>

  <section class="bg-warm-900 py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <p class="text-sm font-medium tracking-wide text-accent/80 mb-4">Practical Guide</p>
      <h1 class="text-3xl md:text-5xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">China 240-Hour Transit Visa-Free Policy</h1>
      <p class="mt-4 text-lg text-warm-200/80 max-w-2xl leading-relaxed">Visit China’s ancient archaeological sites without a visa. How the 10-day transit policy works, who qualifies, and how to plan a visa-free trip.</p>
    </div>
  </section>

  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">What Is the 240-Hour Transit Policy?</h2>
    <div class="space-y-4 text-warm-700 leading-relaxed">
      <p>China allows citizens of <strong>54 countries</strong> to enter without a visa for up to <strong>240 hours (10 days)</strong> when transiting through China to a third country. This means you can visit China as part of a longer international trip without applying for a tourist visa.</p>
      <p>The policy expanded in December 2024 from 72/144 hours to 240 hours, making it long enough to complete our entire 10-day ancient China itinerary. You can fly into Hangzhou, travel by high-speed train through Chengdu and Xi’an to Anyang, and fly out of Beijing — all visa-free.</p>
    </div>
  </section>

  <section class="bg-warm-50 py-12 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-xl font-display font-semibold tracking-tight mb-6">Key Requirements</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div class="bg-white rounded-lg p-4 border border-border"><strong class="block mb-1">1. Eligible passport</strong><span class="text-warm-700">Must hold a passport from one of the 54 eligible countries (includes US, UK, EU, AU, NZ, CA, JP, KR, SG, and others).</span></div>
        <div class="bg-white rounded-lg p-4 border border-border"><strong class="block mb-1">2. Confirmed onward ticket</strong><span class="text-warm-700">Must have a confirmed flight/train ticket to a third country (not the country you flew in from) departing within 240 hours.</span></div>
        <div class="bg-white rounded-lg p-4 border border-border"><strong class="block mb-1">3. Designated ports</strong><span class="text-warm-700">Must enter and exit through designated ports. All major international airports (PEK, PKX, PVG, HGH, CTU, TFU, XIY) and many land ports qualify.</span></div>
        <div class="bg-white rounded-lg p-4 border border-border"><strong class="block mb-1">4. Stay within permitted areas</strong><span class="text-warm-700">Travel is permitted within designated regions. Major cities including Hangzhou, Chengdu, Xi’an, Zhengzhou, Anyang, and Beijing are all covered.</span></div>
      </div>
    </div>
  </section>

  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">How to Use It for the Ancient China Itinerary</h2>
    <div class="bg-white rounded-lg border border-border p-6 text-sm text-warm-700 space-y-3">
      <p><strong>Example routing:</strong></p>
      <p>Fly into <strong>Hangzhou (HGH)</strong> from Tokyo → 40h in Hangzhou (Liangzhu) → train to <strong>Chengdu</strong> → 48h in Chengdu (Sanxingdui) → train to <strong>Xi’an</strong> → 72h in Xi’an (Warriors, Han Yangling, Qianling) → train to <strong>Anyang</strong> → 48h in Anyang (Yin Xu) → train to <strong>Beijing</strong> → fly out of <strong>Beijing (PEK)</strong> to Seoul.</p>
      <p class="text-xs text-muted mt-4">This exact routing takes approximately 210–220 hours, comfortably within the 240-hour limit. Always leave a buffer of at least 6–8 hours for transit delays.</p>
    </div>
  </section>

  <section class="bg-warm-900 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <h2 class="text-xl font-display font-semibold tracking-tight text-white mb-4">Ready to plan your visa-free trip?</h2>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/ancient-china-10-day-itinerary" class="inline-flex items-center justify-center px-8 py-3.5 bg-accent text-white font-medium rounded-lg hover:bg-accent-dark active:scale-[0.98] transition-all duration-150">10-Day Itinerary</a>
        <a href="/" class="inline-flex items-center justify-center px-8 py-3.5 border border-white/40 text-white font-medium rounded-lg hover:bg-white/10 active:scale-[0.98] transition-all duration-150">Browse All Sites</a>
      </div>
    </div>
  </section>
</BaseLayout>
