 ---
 export interface Props {
   items: { label: string; href?: string }[];
 }
 const { items } = Astro.props;
 ---
 <nav aria-label="Breadcrumb" class="max-w-[1200px] mx-auto px-6 py-3">
   <ol class="flex items-center gap-1.5 text-xs text-muted">
     {items.map((item, i) => (
       <>
         {i > 0 && <span class="text-border">/</span>}
         <li>
           {item.href ? (
             <a href={item.href} class="hover:text-accent transition-colors">{item.label}</a>
           ) : (
             <span class="text-warm-700 font-medium">{item.label}</span>
           )}
         </li>
       </>
     ))}
   </ol>
 </nav>
