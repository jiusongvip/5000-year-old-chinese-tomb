---
import { ArrowRight } from '@lucide/astro';

export interface Props {
  title?: string;
  subtitle?: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { title = 'Ready to Walk Through History?', subtitle = 'Everything on this site is designed to move you from curiosity to departure.', primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="bg-warm-900 py-16 reveal">
  <div class="max-w-[800px] mx-auto px-6 text-center">
    <h2 class="text-xl md:text-3xl font-display font-semibold tracking-tight text-white mb-4">{title}</h2>
    {subtitle && <p class="text-warm-200 max-w-xl mx-auto mb-8 text-sm md:text-base">{subtitle}</p>}
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a href={primaryHref} class="inline-flex items-center justify-center gap-2 px-8 py-3.5 btn btn-primary">{primaryLabel}<ArrowRight class="w-4 h-4" /></a>
      {secondaryHref && secondaryLabel && (
        <a href={secondaryHref} class="inline-flex items-center justify-center px-8 py-3.5 btn btn-ghost-light">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>