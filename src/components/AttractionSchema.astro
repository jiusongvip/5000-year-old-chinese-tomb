---
import { touristAttractionSchema, faqSchema } from '../data/schemas';
import { sites } from '../data/sites';

export interface Props {
  slug: string;
  faqs?: { q: string; a: string }[];
}

const { slug, faqs = [] } = Astro.props;
const site = sites.find((s) => s.slug === slug);

if (!site) {
  throw new Error(`AttractionSchema: no site found for slug "${slug}"`);
}

const schemas: any[] = [touristAttractionSchema(site)];
if (faqs.length > 0) {
  schemas.push(faqSchema(faqs));
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)}></script>