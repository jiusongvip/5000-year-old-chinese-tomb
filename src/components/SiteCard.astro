---
import type { Site } from '../data/sites';
import { Landmark } from '@lucide/astro';

interface Props {
  site: Site;
}

const { site } = Astro.props;
---

<div class="group reveal card card-hover overflow-hidden flex flex-col">
  <div class="aspect-[3/2] overflow-hidden bg-warm-100 relative">
    <img src={site.image} alt={site.imageAlt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" width="640" height="427" />
    {site.unesco && (<span class="absolute top-2 left-2 text-[9px] font-bold px-1.5 py-0.5 rounded bg-white/90 text-warm-800 flex items-center gap-1"><Landmark class="w-2.5 h-2.5 text-accent" />UNESCO</span>)}
  </div>
  <div class="p-4 flex flex-col flex-1">
    <h3 class="font-display font-semibold text-lg leading-tight">{site.name}</h3>
    <p class="text-xs text-muted mb-1">{site.yearsAgo.toLocaleString()} years old &middot; {site.city}</p>
    <p class="text-xs text-warm-600 font-medium">{site.culture} &middot; {site.era}</p>
    <div class="mt-3 pt-3 border-t border-border flex items-center justify-between gap-2">
      <p class="text-xs font-medium text-accent">{site.ticketLow === 0 ? 'Free entry' : `Tickets from ¥${site.ticketLow}`}</p>
      <p class="text-xs text-muted">{site.visitTime}</p>
    </div>
  </div>
</div>
