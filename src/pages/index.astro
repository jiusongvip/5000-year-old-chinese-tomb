---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sites } from '../data/sites';
import SiteCard from '../components/SiteCard.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTACard from '../components/CTACard.astro';
import { Landmark, Route, MapPin, Map, Ticket, BadgeCheck, ShieldCheck, Footprints, Ban, ArrowRight, ChevronDown, Calendar, Smartphone, TrainFront, Globe, User, Flower, Sun, Sunset, Snowflake, Wallet, Banknote, CreditCard, Languages, CircleCheck, Utensils, Sparkles } from '@lucide/astro';

const title = 'Walk Through 5,000 Years';
const description = 'Step-by-step guides to visit ancient Chinese archaeological sites — ticket prices, museum booking instructions, and itineraries for foreign travelers.';

const faqHomeSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", "name": "Can I visit ancient Chinese archaeological sites as a foreigner?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Most major archaeological sites in China are open to foreign visitors. Some require advance booking through WeChat mini-programs (especially Sanxingdui and the Shaanxi History Museum). Many nationalities also qualify for China's 240-hour transit visa-free policy, making it easier than ever to visit." } },
    { "@type": "Question", "name": "What is the oldest archaeological site I can visit in China?", "acceptedAnswer": { "@type": "Answer", "text": "The Dawenkou Site in Shandong Province (6,300 years old) is the oldest site on our list that is open to visitors. The Liangzhu Ancient City near Hangzhou (5,300 years old) is a UNESCO World Heritage Site and features an excellent modern museum. Both predate the Egyptian pyramids." } },
    { "@type": "Question", "name": "How do I book Chinese museum tickets with a foreign passport?", "acceptedAnswer": { "@type": "Answer", "text": "Most Chinese museums require booking through WeChat mini-programs. When booking, select 'Passport' (护照) as your ID type and enter your passport number. Some museums sell out weeks in advance (especially Sanxingdui and the Shaanxi History Museum). Our museum booking guides provide step-by-step instructions for each major museum." } },
    { "@type": "Question", "name": "Which ancient Chinese sites are UNESCO World Heritage?", "acceptedAnswer": { "@type": "Answer", "text": "On our site: Liangzhu Ancient City (inscribed 2019), Yin Xu (2006), and the Terracotta Warriors (1987). Sanxingdui is on the UNESCO tentative list. Other UNESCO ancient sites in China include the Longmen Grottoes, Mogao Caves, and the Peking Man site at Zhoukoudian." } },
    { "@type": "Question", "name": "What is the best ancient China itinerary for a first-time visitor?", "acceptedAnswer": { "@type": "Answer", "text": "Our 10-day itinerary covers four major sites (Liangzhu, Sanxingdui, Terracotta Warriors, and Yin Xu) and works as a visa-free transit trip. For a shorter trip, the 7-day Xi'an & Chengdu route focuses on the Terracotta Warriors and Sanxingdui with comfortable train connections." } },
  ],
};

const schemaJson = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": sites.map((s, i) => ({
      "@type": "TouristAttraction",
      "name": s.name,
      "url": `https://www.5000-year-old-chinese-tomb.com/#sites`,
      "position": i + 1,
    })),
  },
  faqHomeSchema,
]);

const eraColors: Record<string, { dot: string; track: string; label: string }> = {
  'Neolithic': { dot: 'bg-jade-500', track: 'bg-jade-400/40', label: 'Neolithic' },
  'Bronze Age': { dot: 'bg-bronze-500', track: 'bg-bronze-400/40', label: 'Bronze Age' },
  'Imperial': { dot: 'bg-clay-500', track: 'bg-clay-400/40', label: 'Imperial' },
};

const eraTimeline = ['Neolithic', 'Bronze Age', 'Imperial'].map((era) => {
  const group = sites.filter((s) => s.era === era);
  const from = Math.max(...group.map((s) => s.yearsAgo));
  const to = Math.min(...group.map((s) => s.yearsAgo));
  const span = from - to || 1;
  return {
    label: eraColors[era].label,
    dot: eraColors[era].dot,
    track: eraColors[era].track,
    range: `${from.toLocaleString()}–${to.toLocaleString()} years ago`,
    sites: group.map((site, idx) => ({
      site,
      pct: ((from - site.yearsAgo) / span) * 100,
      above: idx % 2 === 1,
    })),
  };
});

const relatedLinks = [
  { href: '#best-time', label: 'best time to visit china for ancient sites' },
  { href: '#site-guides', label: 'terracotta warriors tickets' },
  { href: '#site-guides', label: 'how to book sanxingdui tickets with foreign passport' },
  { href: '#practical', label: 'china 240 hour transit visa free' },
  { href: '#sites', label: 'oldest archaeological site in china' },
  { href: '#routes', label: 'ancient china itinerary 10 days' },
  { href: '#money', label: 'how do foreigners pay in china' },
  { href: '#checklist', label: 'china travel packing list' },
];

const practicalGuides = [
  {
    icon: Ticket,
    title: 'Booking tickets with a foreign passport',
    body: "Most top-tier museums — Sanxingdui and the Shaanxi History Museum especially — release tickets only through official WeChat mini-programs, often 3–7 days ahead, and weekend slots can disappear within minutes. When booking, choose 'Passport' (护照) as your ID type, enter your passport number, and bring the physical passport to the gate. A few big sites (Terracotta Warriors) still sell at the window, but expect 1–2 hour queues in peak season.",
  },
  {
    icon: Globe,
    title: "China's 240-hour visa-free transit",
    body: "Citizens of 54 countries can enter China without a visa for up to 10 days when transiting onward to a third country or region. Requirements: an onward ticket, and entry/exit through designated ports within the eligible region. Gateway cities on this site — Hangzhou, Chengdu, Xi'an — are all covered. Confirm your exact route against the official list before booking flights.",
  },
  {
    icon: TrainFront,
    title: 'Getting between cities by high-speed rail',
    body: "China's high-speed rail network connects nearly every site on this page, and you book with your passport on official channels (12306 or trip.com). E-tickets are scanned by passport at the gate — no paper collection. Xi'an–Chengdu is a ~3-hour ride; Xi'an to Anyang runs about 2.5 hours; Hangzhou to Chengdu is long enough that most travelers fly instead.",
  },
  {
    icon: Smartphone,
    title: 'SIM cards & staying connected',
    body: "Every booking mini-program, map, and translator needs data. The easiest option is an eSIM activated before you fly; otherwise grab a tourist SIM at the airport. One honest warning: Google Maps and many Google services don't work reliably in mainland China — download Amap or Baidu Maps, plus the WeChat app itself, before you land.",
  },
  {
    icon: User,
    title: 'Do you actually need a tour guide?',
    body: "Honest answer: usually no. Every site here has English signage and tickets bookable by passport. A licensed guide earns its 300–600 CNY/day when you want deeper history (Terracotta Warriors, Yin Xu) or are heading somewhere remote like Qianling. For the 10-day itinerary, skip the guide and save the budget for good hotels.",
  },
];

const bestTimes = [
  { icon: Flower, season: 'Spring', months: 'March – May', temp: '15–25°C', verdict: 'Mild weather, the fewest crowds, and Hangzhou\u2019s blossom season. The best all-round window for Liangzhu and the southern sites.', accent: 'text-jade-600 bg-jade-500/10' },
  { icon: Sun, season: 'Summer', months: 'June – August', temp: '30–38°C', verdict: 'Hottest and busiest — July and August are Chinese school holidays. Book tickets days ahead and start early to beat the heat.', accent: 'text-clay-600 bg-clay-500/10' },
  { icon: Sunset, season: 'Autumn', months: 'September – November', temp: '15–25°C', verdict: 'Clear skies and comfortable temperatures. The golden season for photography at the Terracotta Warriors and Liangzhu.', accent: 'text-bronze-600 bg-bronze-500/10' },
  { icon: Snowflake, season: 'Winter', months: 'December – February', temp: '0–10°C', verdict: 'Cold but quiet — cheaper hotels and short queues. Bundle up for outdoor sites like Yin Xu and Qianling.', accent: 'text-stone-600 bg-stone-500/10' },
];

const siteGuides: Record<string, { getThere: string; eat: string; tip: string }> = {
  'dawenkou-site': {
    getThere: "Tai'an sits on the Beijing–Shanghai high-speed line. From Tai'an station it's a 25-minute taxi (about ¥40) to the site, and the Dawenkou Museum is right across the road.",
    eat: "Tai'an's morning-market classics are fried zha cake (炸糕) and lamb soup — grab both before you visit the site.",
    tip: 'The site itself is an open field, so go in the morning while the museum is quiet. Pair it with Mount Tai if you have a spare day.',
  },
  'liangzhu-ancient-city': {
    getThere: 'Take Hangzhou Metro Line 2 to Liangzhu Station, then a 15-minute shuttle or taxi to the park — about an hour door to door from downtown.',
    eat: 'Hangzhou is Longjing tea and Dongpo pork country. The Liangzhu Museum canteen is genuinely good and cheap, or bring a picnic for the city-wall park.',
    tip: 'Rent the electric cart or a bike to cover the vast earthen walls; the jade gallery (cong tubes and bi disks) is the unmissable highlight.',
  },
  'sanxingdui': {
    getThere: 'Take the intercity train from Chengdu East to Guanghan North (about 20 minutes), then a 15-minute taxi. A half-day guided tour from Chengdu is the no-hassle alternative.',
    eat: "Guanghan's rabbit hotpot (兔火锅) is the local legend — spicy, cheap, and best shared. Chengdu's teahouses are a comfortable fallback.",
    tip: 'Book the new museum tickets days ahead on WeChat and arrive right at 8:30 to beat the tour groups into the bronze exhibition hall.',
  },
  'yin-xu-anyang': {
    getThere: 'Anyang East station sits on the Beijing–Guangzhou high-speed line. From the station it\u2019s a 30-minute taxi (about ¥60) to the ruins; start at the Yin Xu Museum.',
    eat: "Anyang's donkey soup (安阳驴肉汤) is a local institution — warming and filling, ideal before a long walk around the ruins.",
    tip: 'This is a big open-air site. Wear walking shoes and don\u2019t skip the Fu Hao tomb area — it\u2019s the quietest and most atmospheric corner.',
  },
  'terracotta-warriors': {
    getThere: "From Xi'an, take Metro Line 9 to Huaqingchi, then the short shuttle to the site — about 1.5 hours door to door. A taxi runs around ¥150.",
    eat: "The roujiamo (Chinese burger) and biangbiang noodles near the visitor center are surprisingly decent fuel for the walk around all three pits.",
    tip: 'Enter Pit 1 the moment it opens at 8:30, then do Pit 3 before the crowds arrive — the army looks best in the low morning light.',
  },
  'han-yangling-mausoleum': {
    getThere: 'About 40 minutes northwest of Xi\u2019an by taxi (around ¥100). It\u2019s the quietest major site on this page, with parking and a cafe on site.',
    eat: 'Fill up on a proper Xi\u2019an breakfast — roujiamo and yangrou paomo — before you head out; on-site food options are limited.',
    tip: 'The underground glass corridor over 50,000 miniature figures is the star. Go midweek and you may have the hall almost to yourself.',
  },
  'mawangdui-han-tombs': {
    getThere: 'The relics now live at the Hunan Museum, reached by Metro Line 6 (Hunan Museum station) or a short taxi from downtown Changsha.',
    eat: "Changsha is the food capital of Hunan — stinky tofu (臭豆腐) and tea-oil-smoked duck (茶油鸭) are the must-tries around the museum district.",
    tip: 'Entry is free but the queue is fierce. Book your free ticket on the official WeChat mini-program up to 7 days ahead and head straight to the Lady Dai gallery first.',
  },
  'qianling-mausoleum': {
    getThere: 'Qianling sits about 80 km from Xi\u2019an — 1.5 hours by taxi (around ¥250 one way) or a day tour. Public buses connect from Xi\u2019an bus station.',
    eat: "Nearby Xianyang serves northern Shaanxi classics — biangbiang noodles and qishan roujiamo. Pack snacks; the site restaurant is basic.",
    tip: 'The tomb itself is unopened, so you walk the Spirit Way past 120 stone statues — allow 3–4 hours and go in the morning before the heat.',
  },
};

const moneyCards = [
  { icon: Wallet, title: 'Alipay & WeChat Pay', body: 'Nearly everything in China is paid by scanning a QR code. Both Alipay and WeChat Pay now support foreign Visa/Mastercard and English UI — verify with your passport before you fly and you\u2019ll pay like a local.' },
  { icon: Banknote, title: 'Keep cash as backup', body: 'Taxis, street food, and a few small museums still prefer cash. Carry ¥500–1,000 in small notes. ATMs at airports and major banks accept international cards.' },
  { icon: CreditCard, title: 'International cards work, barely', body: 'Big hotels and some chains accept Visa/Mastercard, but don\u2019t rely on them for taxis, market food, or museum gates. Treat your card as plan C, not plan A.' },
];

const phrases = [
  { zh: '你好', pinyin: 'nǐ hǎo', en: 'Hello' },
  { zh: '谢谢', pinyin: 'xièxie', en: 'Thank you' },
  { zh: '我要买票', pinyin: 'wǒ yào mǎi piào', en: 'I\u2019d like to buy a ticket' },
  { zh: '护照', pinyin: 'hùzhào', en: 'Passport' },
  { zh: '这里多少钱？', pinyin: 'zhèlǐ duōshǎo qián?', en: 'How much is this?' },
  { zh: '厕所在哪里？', pinyin: 'cèsuǒ zài nǎlǐ?', en: 'Where is the restroom?' },
  { zh: '有英文介绍吗？', pinyin: 'yǒu yīngwén jièshào ma?', en: 'Is there an English guide?' },
  { zh: '我不会说中文', pinyin: 'wǒ bú huì shuō zhōngwén', en: 'I don\u2019t speak Chinese' },
];

const checklist = [
  'Set up Alipay and WeChat Pay, verify with your passport, and link a card',
  'Save photos of your passport pages and visa on your phone',
  'Download Amap or Baidu Maps — Google Maps is unreliable in mainland China',
  'Install an eSIM or tourist SIM before you land',
  'Pack comfortable walking shoes — every site is large and mostly outdoor',
  'Bring light layers: museum halls are cold, outdoor sites are hot',
  'Pack sunscreen, a hat, and a power bank for long days',
  'Book Sanxingdui and Shaanxi History Museum the moment ticket slots open',
];

const siteStats = {
  total: sites.length,
  unesco: sites.filter((s) => s.unesco).length,
  provinces: new Set(sites.map((s) => s.province)).size,
  oldest: Math.max(...sites.map((s) => s.yearsAgo)),
  newest: Math.min(...sites.map((s) => s.yearsAgo)),
};
---

<BaseLayout {title} {description} schemaJson={schemaJson}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
  </Fragment>

  <!-- Hero -->
  <section class="relative min-h-[100dvh] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/og-home.webp" srcset="/og-home-800.webp 800w, /og-home-1200.webp 1200w, /og-home.webp 1600w" sizes="100vw" alt="Ancient Chinese archaeological sites — terracotta warriors, jade artifacts, and bronze relics spanning 5,000 years of history" width="1600" height="900" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-b from-warm-900/60 via-warm-900/40 to-surface"></div>
    </div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 pt-16 pb-24">
      <p class="text-sm font-medium tracking-wide text-warm-200/80 mb-6">Ancient China Travel</p>
      <h1 class="text-4xl md:text-6xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">Walk Through 5,000 Years of Chinese History</h1>
      <p class="mt-6 text-lg md:text-xl text-warm-100/90 max-w-2xl leading-relaxed">Step-by-step guides to visit China's most remarkable archaeological sites — with real ticket prices, passport-tested booking instructions, and routes designed by someone who has walked every one of them.</p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a href="#sites" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 btn btn-primary text-base"><Landmark class="w-4 h-4" /> Browse Sites</a>
        <a href="#routes" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 btn btn-ghost-light text-base"><Route class="w-4 h-4" /> Plan Your Route</a>
      </div>
      <div class="mt-16 hidden md:block">
        <p class="text-xs text-warm-200/50 tracking-wide">SCROLL</p>
        <div class="mt-2 w-px h-8 bg-warm-200/30 mx-auto"></div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-border/60 bg-warm-50/60">
    <div class="max-w-[1200px] mx-auto px-6 py-10 grid grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center">
        <p class="font-display text-3xl md:text-4xl font-bold text-clay-600">{siteStats.total}</p>
        <p class="mt-1 text-xs text-muted uppercase tracking-wide">Sites open to visitors</p>
      </div>
      <div class="text-center">
        <p class="font-display text-3xl md:text-4xl font-bold text-clay-600">{siteStats.unesco}</p>
        <p class="mt-1 text-xs text-muted uppercase tracking-wide">UNESCO World Heritage</p>
      </div>
      <div class="text-center">
        <p class="font-display text-3xl md:text-4xl font-bold text-clay-600">{siteStats.provinces}</p>
        <p class="mt-1 text-xs text-muted uppercase tracking-wide">Provinces to explore</p>
      </div>
      <div class="text-center">
        <p class="font-display text-3xl md:text-4xl font-bold text-clay-600">{siteStats.oldest.toLocaleString()}</p>
        <p class="mt-1 text-xs text-muted uppercase tracking-wide">Years of history — oldest site</p>
      </div>
    </div>
  </section>

  <!-- Why This Site Exists -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <p class="text-sm font-medium tracking-wide text-accent/80 mb-3">Why This Site Exists</p>
    <p class="text-warm-700 leading-relaxed">
      In October 2024, Chinese archaeologists uncovered a <a href="#sites" class="text-accent font-medium hover:underline">5,000-year-old tomb in Henan</a> with 350 burial objects and nearly 200 jade artifacts. The discovery made global headlines. But when would-be visitors searched for how to go see it, they found nothing — only news articles that ended with a period. No museum opening hours. No ticket booking instructions. No answer to the simplest question: <em>"What ancient Chinese sites can I actually visit?"</em>
    </p>
    <p class="text-warm-700 leading-relaxed mt-4">
      This site is the answer. Eight extraordinary archaeological sites, all open to visitors. Real prices. Real routes. Every booking guide tested with a foreign passport. No generic travel-site filler — just the information you need to walk through 5,000 years of Chinese history yourself.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-2 text-xs text-muted">
      <span class="inline-block h-px w-6 bg-accent/40" aria-hidden="true"></span>
      Written by <strong class="text-warm-700 font-medium">Alex Chen</strong>
      <span aria-hidden="true">&middot;</span>
      Updated August 2026
      <span aria-hidden="true">&middot;</span>
      Every site visited firsthand
    </div>
  </section>

  <!-- Time Corridor -->
  <section id="timeline" class="py-16 max-w-[1200px] mx-auto px-6 reveal">
    <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 text-center">The Time Corridor</h2>
    <p class="text-center text-muted text-sm max-w-2xl mx-auto">From the dawn of Chinese civilization (6,300 years ago) to the Tang Dynasty (1,300 years ago) — three eras, at scale. Every site below is open to visitors today.</p>
    <div class="mt-12 overflow-x-auto pb-4">
      <div class="min-w-[560px] space-y-12">
        {eraTimeline.map((era) => (
          <div class="flex items-center gap-5 sm:gap-8">
            <div class="w-36 sm:w-44 shrink-0">
              <div class="flex items-center gap-2">
                <span class={`h-2.5 w-2.5 rounded-full ${era.dot}`} aria-hidden="true"></span>
                <span class="text-sm font-display font-semibold text-warm-900">{era.label}</span>
              </div>
              <p class="text-xs text-muted mt-1 whitespace-nowrap">{era.range}</p>
            </div>
            <div class="flex-1 relative h-32">
              <div class={`absolute left-0 right-0 top-1/2 -translate-y-1/2 h-1.5 rounded-full ${era.track}`} aria-hidden="true"></div>
              {era.sites.map((n) => (
                <a
                  href="#sites"
                  class="group absolute top-1/2 -translate-x-1/2 -translate-y-1/2"
                  style={`left:${n.pct}%`}
                >
                  <span class={`absolute left-1/2 top-1/2 h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full ring-2 ring-paper-50 ${era.dot}`} aria-hidden="true"></span>
                  {n.above ? (
                    <span class="absolute left-1/2 bottom-1/2 mb-5 -translate-x-1/2 text-center w-max">
                      <span class="block text-[13px] sm:text-sm font-semibold text-warm-900 group-hover:text-accent transition-colors">{n.site.name.split(' ')[0]}</span>
                      <span class="block text-xs text-muted">{n.site.yearsAgo.toLocaleString()} yr</span>
                    </span>
                  ) : (
                    <span class="absolute left-1/2 top-1/2 mt-5 -translate-x-1/2 text-center w-max">
                      <span class="block text-[13px] sm:text-sm font-semibold text-warm-900 group-hover:text-accent transition-colors">{n.site.name.split(' ')[0]}</span>
                      <span class="block text-xs text-muted">{n.site.yearsAgo.toLocaleString()} yr</span>
                    </span>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Site Cards -->
  <section id="sites" class="max-w-[1200px] mx-auto px-6 pb-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">Ancient Sites You Can Walk Through</h2>
        <p class="text-muted max-w-2xl reveal">Every site on this page has been visited, photographed, and documented firsthand. Ticket prices verified August 2026.</p>
      </div>
      <a href="#plan" class="hidden md:inline-flex items-center gap-2 text-sm text-accent hover:underline flex-shrink-0 ml-6">Plan your trip <ArrowRight class="w-4 h-4" /></a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {sites.map((site) => (
        <SiteCard {site} />
      ))}
    </div>
  </section>

  <!-- Comparison Table -->
  <section id="compare" class="max-w-[1200px] mx-auto px-6 pb-20 reveal">
    <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2">Every Site at a Glance</h2>
    <p class="text-muted mb-8 max-w-2xl">Prices, hours, and travel time for all {siteStats.total} sites — verified August 2026. No sign-up, no login, just the numbers you need to plan.</p>
    <div class="overflow-x-auto rounded-2xl border border-border shadow-sm">
      <table class="w-full min-w-[860px] text-sm">
        <thead>
          <tr class="bg-warm-50 text-left text-xs uppercase tracking-wide text-muted">
            <th class="px-4 py-3 font-semibold">Site</th>
            <th class="px-4 py-3 font-semibold">Era</th>
            <th class="px-4 py-3 font-semibold">Culture</th>
            <th class="px-4 py-3 font-semibold">City</th>
            <th class="px-4 py-3 font-semibold">Tickets</th>
            <th class="px-4 py-3 font-semibold">Hours</th>
            <th class="px-4 py-3 font-semibold">Visit</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((site, i) => (
            <tr class={`border-t border-border ${i % 2 === 0 ? 'bg-surface' : 'bg-warm-50/40'}`}>
              <td class="px-4 py-3 font-medium text-warm-900">
                <div class="flex items-center gap-2">
                  {site.name}
                  {site.unesco && <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-accent/10 text-accent shrink-0">UNESCO</span>}
                </div>
              </td>
              <td class="px-4 py-3 text-warm-700">{site.era}</td>
              <td class="px-4 py-3 text-warm-700">{site.culture}</td>
              <td class="px-4 py-3 text-warm-700">{site.city}</td>
              <td class="px-4 py-3 text-warm-700 whitespace-nowrap">
                {site.ticketLow === 0
                  ? <span class="font-medium text-jade-600">Free</span>
                  : <span class="font-medium text-accent">{site.ticketLow === site.ticketHigh ? `¥${site.ticketLow}` : `¥${site.ticketLow}–${site.ticketHigh}`}</span>}
              </td>
