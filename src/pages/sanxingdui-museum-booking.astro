---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "How to Book Sanxingdui Museum Tickets as a Foreigner (2026 Step-by-Step)";
const description = "Step-by-step guide for foreigners to book Sanxingdui Museum tickets with a passport. How to use the WeChat mini-program, ticket release times, and what to do if you don’t have a Chinese phone number. Updated August 2026.";

const howToSchema = {
  "@type": "HowTo",
  "name": "How to Book Sanxingdui Museum Tickets with a Foreign Passport",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Open WeChat and search for the mini-program", "text": "Open WeChat, tap the search bar at the top, and search for “三星堆博物馆” (Sanxingdui Museum). Tap the official mini-program result with the museum logo." },
    { "@type": "HowToStep", "position": 2, "name": "Select ticket type and date", "text": "Tap “个人预约” (Individual Reservation). Choose your visit date. Tickets are released 7 days in advance at 8:00 PM Beijing time." },
    { "@type": "HowToStep", "position": 3, "name": "Enter passport information", "text": "In the ID type dropdown, select “护照” (Passport). Enter your passport number and name exactly as they appear on your passport. Tap confirm." },
    { "@type": "HowToStep", "position": 4, "name": "Select time slot and pay", "text": "Choose morning (8:30–12:00) or afternoon (12:00–17:00) entry. Tap pay. If WeChat Pay is not set up, ask a friend, hotel staff, or use a WeChat Pay international card." },
    { "@type": "HowToStep", "position": 5, "name": "Save your booking confirmation", "text": "After payment, screenshot the QR code confirmation. You will need it at the museum entrance along with your passport." },
  ],
  "totalTime": "PT10M"
};

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", "name": "When are Sanxingdui tickets released?", "acceptedAnswer": { "@type": "Answer", "text": "Tickets are released 7 days in advance at 8:00 PM Beijing time (12:00 UTC). For example, tickets for August 11 go on sale at 8:00 PM on August 4. During Chinese holidays, tickets can sell out within minutes." } },
    { "@type": "Question", "name": "Can I buy Sanxingdui tickets at the door?", "acceptedAnswer": { "@type": "Answer", "text": "No, Sanxingdui no longer sells tickets at the door. All tickets must be booked online in advance through the WeChat mini-program. This policy was introduced with the new museum in 2023." } },
    { "@type": "Question", "name": "What if I don’t have a Chinese phone number?", "acceptedAnswer": { "@type": "Answer", "text": "The WeChat booking system requires a Chinese phone number to create an account. If you do not have one, you have several options: (1) Buy a Chinese SIM card at the airport on arrival, (2) Ask your hotel front desk to book on your behalf, or (3) Book a guided tour through Klook or GetYourGuide that includes the ticket." } },
    { "@type": "Question", "name": "Can I use my passport to enter Sanxingdui?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. When booking, select “护照” (Passport) as your ID type. Bring your physical passport to the museum — a photo or copy will not be accepted." } },
    { "@type": "Question", "name": "What if tickets are sold out?", "acceptedAnswer": { "@type": "Answer", "text": "If tickets are sold out, you have three options: (1) Check back periodically — cancellations sometimes release tickets, (2) Book through Klook or GetYourGuide who may have pre-purchased ticket blocks, or (3) Visit on a weekday outside of holiday periods when availability is better." } },
  ],
};

const schemaJson = JSON.stringify([howToSchema, faqSchema,
{
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://5000-year-old-chinese-tomb.com" },
      { "@type": "ListItem", "position": 2, "name": "Sanxingdui Museum Booking", "item": "https://5000-year-old-chinese-tomb.com/sanxingdui-museum-booking" }
    ]
  },
]);
---

<BaseLayout {title} {description} schemaJson={schemaJson} lastUpdated="August 4, 2026">
  <slot name="head">
    <meta property="og:image" content="https://5000-year-old-chinese-tomb.com/og-booking-sanxingdui.webp" />
  </slot>

  <!-- Hero -->
  <section class="bg-warm-900 py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <p class="text-sm font-medium tracking-wide text-accent/80 mb-4">Booking Guide</p>
      <h1 class="text-3xl md:text-5xl font-display font-bold tracking-tight leading-tight text-white max-w-3xl">How Foreigners Can Book Sanxingdui Museum Tickets</h1>
      <p class="mt-4 text-lg text-warm-200/80 max-w-2xl leading-relaxed">The complete step-by-step guide. How to use the WeChat mini-program with a passport, when tickets are released, and what to do if you get stuck.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">¥72 ticket</span>
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">7 days in advance</span>
        <span class="text-xs px-3 py-1.5 rounded-full bg-white/10 text-warm-100">WeChat required</span>
      </div>
    </div>
  </section>

  <!-- Basic Info -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-4">Ticket Basics</h2>
    <div class="bg-white rounded-lg border border-border p-6 space-y-3 text-sm">
      <div class="flex justify-between py-1.5 border-b border-border/50"><span class="text-muted">Price</span><span class="font-semibold text-warm-900">¥72</span></div>
      <div class="flex justify-between py-1.5 border-b border-border/50"><span class="text-muted">Release schedule</span><span class="font-semibold text-warm-900">7 days ahead, 8:00 PM Beijing time</span></div>
      <div class="flex justify-between py-1.5 border-b border-border/50"><span class="text-muted">Entry windows</span><span class="font-semibold text-warm-900">Morning 8:30–12:00 / Afternoon 12:00–17:00</span></div>
      <div class="flex justify-between py-1.5"><span class="text-muted">Booking method</span><span class="font-semibold text-warm-900">WeChat mini-program only (no walk-in tickets)</span></div>
    </div>
    <div class="mt-4 bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-800">
      <strong>During Chinese holidays, Sanxingdui tickets sell out within minutes.</strong> The museum is extremely popular with domestic tourists. Book the moment tickets are released, or use an alternative booking method (see below).
    </div>
  </section>

  <!-- Step by Step -->
  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-8">Step-by-Step Booking with a Foreign Passport</h2>
      <div class="space-y-6">

        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">1</span>
          <div>
            <h3 class="font-semibold mb-1">Open WeChat and find the mini-program</h3>
            <p class="text-sm text-warm-700 leading-relaxed">Open WeChat. Tap the search bar at the top. Search for <strong>三星堆博物馆</strong> (Sanxingdui Museum). Look for the result labeled “Mini Programs” with the official museum logo. Tap it. If you see multiple results, choose the one with a blue verified badge.</p>
          </div>
        </div>

        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">2</span>
          <div>
            <h3 class="font-semibold mb-1">Select reservation type</h3>
            <p class="text-sm text-warm-700 leading-relaxed">On the main page, tap <strong>个人预约</strong> (Individual Reservation). Do not select the group reservation option. You will see a calendar showing available dates. Dates in gray are sold out; dates in blue are available.</p>
          </div>
        </div>

        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">3</span>
          <div>
            <h3 class="font-semibold mb-1">Choose your date and time slot</h3>
            <p class="text-sm text-warm-700 leading-relaxed">Tap an available date. You will see two time slots: <strong>上午 8:30–12:00</strong> (morning) and <strong>下午 12:00–17:00</strong> (afternoon). The morning slot is recommended — the museum is quieter and you have more time. Tap your preferred slot.</p>
          </div>
        </div>

        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">4</span>
          <div>
            <h3 class="font-semibold mb-1">Enter your passport details</h3>
            <p class="text-sm text-warm-700 leading-relaxed">This is the most important step for foreigners. Tap the ID type dropdown (证件类型) and scroll down to select <strong>护照</strong> (Passport). Enter your passport number exactly as it appears. Enter your full name in the same format as your passport. <strong>Double-check every character.</strong> Mismatched details will prevent entry.</p>
          </div>
        </div>

        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">5</span>
          <div>
            <h3 class="font-semibold mb-1">Add a phone number and pay</h3>
            <p class="text-sm text-warm-700 leading-relaxed">Enter a Chinese phone number if you have one. If not, you can sometimes use an international number. Tap submit and proceed to payment. If your WeChat Pay is not set up with an international card, you have three options: (a) ask a Chinese friend to pay and transfer them cash, (b) ask your hotel front desk, or (c) use Klook to book instead (see alternatives below).</p>
          </div>
        </div>

        <div class="bg-white rounded-lg p-6 border border-border flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent text-white text-sm font-bold flex items-center justify-center">6</span>
          <div>
            <h3 class="font-semibold mb-1">Save your confirmation</h3>
            <p class="text-sm text-warm-700 leading-relaxed">After successful payment, you will see a QR code confirmation. <strong>Take a screenshot immediately.</strong> You can also find it later in WeChat under Me → Services → Orders. At the museum, show the QR code and your passport at the foreign passport lane.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Common Problems -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Common Problems & Solutions</h2>
    <div class="space-y-4 text-sm text-warm-700">
      <div class="bg-white rounded-lg p-5 border border-border">
        <h3 class="font-semibold mb-2">“No Chinese phone number”</h3>
        <p>Buy a SIM card at the airport on arrival (¥100–200 for a tourist plan), ask your hotel front desk to book on your behalf, or use a Klook/GetYourGuide tour package that includes tickets. Some users report success with international numbers, but this is not officially supported.</p>
      </div>
      <div class="bg-white rounded-lg p-5 border border-border">
        <h3 class="font-semibold mb-2">“Can’t pay with WeChat Pay”</h3>
        <p>Set up WeChat Pay with an international credit card before your trip (Settings → Wallet → Add a Card). This works for most major cards. As a backup, carry cash to reimburse a friend or hotel staff member who books for you.</p>
      </div>
      <div class="bg-white rounded-lg p-5 border border-border">
        <h3 class="font-semibold mb-2">“Passport number rejected”</h3>
        <p>Make sure you selected “护照” (Passport) as the ID type, not “身份证” (Chinese ID). Enter your passport number without spaces or dashes. Check that your name is entered in the same order as your passport (surname first for most passports).</p>
      </div>
      <div class="bg-white rounded-lg p-5 border border-border">
        <h3 class="font-semibold mb-2">“Sold out on my date”</h3>
        <p>Check back periodically — cancellations happen. Alternatively, book through Klook which may have pre-purchased ticket blocks. If all else fails, visit on an early weekday morning (Tuesday–Thursday) when demand is lowest, and try to book as soon as the 7-day window opens.</p>
      </div>
    </div>
  </section>

  <!-- Alternatives -->
  <section class="bg-warm-50 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Alternative: Book Through Klook or GetYourGuide</h2>
      <p class="text-sm text-warm-700 leading-relaxed mb-6">If the WeChat booking process is too difficult, several platforms offer Sanxingdui tickets bundled with transport or guided tours. This is the easiest option for most foreign travelers.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg p-5 border border-border">
          <h3 class="font-semibold mb-2">Klook</h3>
          <p class="text-sm text-warm-700">Sells Sanxingdui day trips from Chengdu including round-trip transport and English-speaking guide. Prices from ¥400–600. Book with international credit card, instant confirmation. Recommended first choice.</p>
        </div>
        <div class="bg-white rounded-lg p-5 border border-border">
          <h3 class="font-semibold mb-2">GetYourGuide / Viator</h3>
          <p class="text-sm text-warm-700">Similar packages available. Slightly higher prices (¥500–800) but more English-language support and easier cancellation policies.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-warm-900 py-16 reveal">
    <div class="max-w-[800px] mx-auto px-6 text-center">
      <h2 class="text-xl font-display font-semibold tracking-tight text-white mb-4">Ready to see the bronze masks?</h2>
      <p class="text-warm-200 max-w-lg mx-auto mb-8">Read our full Sanxingdui guide for transport directions, what to see, and whether it is worth the trip.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/sanxingdui" class="inline-flex items-center justify-center px-8 py-3.5 bg-accent text-white font-medium rounded-lg hover:bg-accent-dark active:scale-[0.98] transition-all duration-150">Sanxingdui Site Guide</a>
        <a href="/xian-chengdu-ancient-sites" class="inline-flex items-center justify-center px-8 py-3.5 border border-white/40 text-white font-medium rounded-lg hover:bg-white/10 active:scale-[0.98] transition-all duration-150">Xi’an & Chengdu Route</a>
      </div>
    </div>
  </section>
</BaseLayout>
