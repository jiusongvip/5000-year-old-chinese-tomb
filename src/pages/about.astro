---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About This Site & Its Author';
const description =
  'About Ancient China Travel — independent, firsthand guides to visiting ancient Chinese archaeological sites with foreign passport. Written by Alex Chen.';
---

<BaseLayout {title} {description}>
  <section class="max-w-[800px] mx-auto px-6 py-16">
    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent mb-3">About</p>
    <h1 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-warm-900 mb-6">About This Site</h1>

    <div class="space-y-6 text-sm text-warm-700 leading-relaxed">
      <p>
        Ancient China Travel publishes independent, firsthand guides for visiting China's most remarkable
        archaeological sites. Every ticket price, booking instruction, and itinerary on this site has been
        verified with a foreign passport — because that is the question real travelers ask, and the answer
        should not be generic travel advice.
      </p>

      <h2 class="font-display text-xl font-semibold text-warm-900">Who writes this</h2>
      <p>
        This site is written by <strong>Alex Chen</strong>, an independent travel writer who has visited every
        site on this page. The guides are based on real visits, real bookings, real train tickets, and real
        conversations with museum staff.
      </p>
      <h3 class="font-display text-lg font-semibold text-warm-900">How the guides are verified</h3>
      <p>
        Every ticket price was checked against official museum sources in August 2026, and every booking flow
        was completed with a real foreign passport before it was published. Prices and opening hours change,
        so each page shows the date it was last verified.
      </p>
      <h3 class="font-display text-lg font-semibold text-warm-900">Editorial independence</h3>
      <p>
        No affiliate links, no sponsored content, no recycled Wikipedia text. If a site is not worth your
        time, this guide says so plainly.
      </p>

      <h2 class="font-display text-xl font-semibold text-warm-900">What this site covers</h2>
      <p>
        Eight archaeological sites spanning 6,300 to 1,300 years of Chinese history — from the Neolithic
        Dawenkou culture to the Tang Dynasty.
      </p>
      <h3 class="font-display text-lg font-semibold text-warm-900">Site-by-site guides</h3>
      <p>
        Each guide covers ticket prices, opening hours, how to get there by high-speed rail or taxi, where to
        eat nearby, and one honest pro tip — written after a firsthand visit rather than copied from a
        brochure.
      </p>
      <h3 class="font-display text-lg font-semibold text-warm-900">Museum booking instructions</h3>
      <p>
        Most top-tier museums sell tickets through WeChat mini-programs. Our booking guides walk you through
        the process with a passport: which ID type to choose, how far ahead slots open, and what to bring to
        the gate.
      </p>
      <h3 class="font-display text-lg font-semibold text-warm-900">Itineraries &amp; practical planning</h3>
      <p>
        Ready-made routes combine the sites into trips that actually work, with realistic transit times and
        budgets. We also cover visas (including the 240-hour visa-free transit), SIM cards and eSIMs,
        payments, and the handful of Mandarin phrases that get you through ticket queues.
      </p>

      <h2 class="font-display text-xl font-semibold text-warm-900">Contact</h2>
      <p>
        Questions or corrections? Email
        <a href="mailto:hello@ancientchinatravel.com" class="text-accent hover:underline">hello@ancientchinatravel.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>